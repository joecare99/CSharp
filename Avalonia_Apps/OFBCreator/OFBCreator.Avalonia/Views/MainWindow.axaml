<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OFBCreator.Avalonia.Views.MainWindow"
        Width="1120"
        Height="820"
        MinWidth="900"
        MinHeight="650"
        Title="OFB Creator">
  <Grid RowDefinitions="Auto,*" Margin="18">
    <Grid.Styles>
      <Style Selector="Border.privacy-person">
        <Setter Property="BorderBrush" Value="#4CAF50" />
      </Style>
      <Style Selector="Border.privacy-person.modified">
        <Setter Property="BorderBrush" Value="#FFB300" />
      </Style>
    </Grid.Styles>
    <Border Grid.Row="0" Padding="0,0,0,14">
      <StackPanel>
        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Ortsfamilienbuch Creator" />
        <TextBlock Opacity="0.72" Text="Portable project workspace — the same .ofbproject is used by the CLI." />
      </StackPanel>
    </Border>
    <TabControl Grid.Row="1">
      <TabItem Header="Project">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="14">
            <TextBlock Text="Portable project file" FontWeight="SemiBold" />
            <TextBox PlaceholderText="{Binding DefaultProjectPath}" Text="{Binding ProjectFilePath}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="New" Command="{Binding NewProjectCommand}" />
              <Button Content="Open..." Command="{Binding BrowseProjectCommand}" />
              <Button Content="Open path" Command="{Binding OpenProjectCommand}" />
              <Button Content="Choose folder" Command="{Binding SelectProjectFolderCommand}" />
              <Button Content="Save as..." Command="{Binding SaveProjectAsCommand}" />
              <Button Content="Save" Command="{Binding SaveProjectCommand}" />
            </StackPanel>
            <TextBlock Text="Project name" />
            <TextBox Text="{Binding Name}" />
            <TextBlock Text="Document title" />
            <TextBox Text="{Binding Title}" />
            <TextBlock Text="Recent projects" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ItemsControl ItemsSource="{Binding RecentProjects}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Content="{Binding}"
                          Command="{Binding $parent[Window].DataContext.OpenRecentProjectCommand}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Source &amp; Export">
        <ScrollViewer>
          <StackPanel Spacing="9" Margin="14">
            <TextBlock Text="GEDCOM input path" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" PlaceholderText="Relative to the project file or absolute" Text="{Binding InputPath}" />
              <Button Grid.Column="1" Content="Open GEDCOM..." Command="{Binding OpenGedcomFileCommand}" />
            </Grid>
            <TextBlock Text="DOCX output path" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" PlaceholderText="{Binding DefaultOutputPath}" Text="{Binding OutputPath}" />
              <Button Grid.Column="1" Content="Choose folder" Command="{Binding SelectOutputFolderCommand}" />
              <Button Grid.Column="2" Content="Save as..." Command="{Binding SaveDocxAsCommand}" />
            </Grid>
            <TextBlock Text="Entry template (gc, ak, or JSON path)" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Width="420" Text="{Binding EntryTemplate}" />
              <Button Content="Validate template" Command="{Binding ValidateTemplateCommand}" />
            </StackPanel>
            <TextBlock Text="Date display culture" />
            <ComboBox Width="180" HorizontalAlignment="Left"
                      ItemsSource="{Binding ExportCultureOptions}"
                      SelectedItem="{Binding ExportCulture}" />
            <TextBlock Text="Place filter (optional)" />
            <TextBox Text="{Binding PlaceId}" />
            <CheckBox Content="Include descendants of families matching the place filter"
                      IsChecked="{Binding IncludeDescendants}" />
            <TextBlock Text="Preface" />
            <TextBox AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap" Text="{Binding Preface}" />
            <TextBlock Text="Legend" />
            <TextBox AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap" Text="{Binding Legend}" />
            <Button HorizontalAlignment="Left" Padding="18,8" Content="Save project and export DOCX"
                    Command="{Binding ExportCommand}" IsEnabled="{Binding IsNotBusy}" />
            <Button HorizontalAlignment="Left" Content="Cancel export"
                    Command="{Binding ExportCancelCommand}" IsEnabled="{Binding IsBusy}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Layout &amp; styles">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="14">
            <TextBlock Text="Page margins (millimeters)" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Top" />
                <NumericUpDown Minimum="5" Maximum="100" Value="{Binding LayoutEditor.TopMarginMm}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Bottom" />
                <NumericUpDown Minimum="5" Maximum="100" Value="{Binding LayoutEditor.BottomMarginMm}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Left / inside" />
                <NumericUpDown Minimum="5" Maximum="100" Value="{Binding LayoutEditor.LeftMarginMm}" />
              </StackPanel>
              <StackPanel Grid.Column="3" Spacing="4">
                <TextBlock Text="Right / outside" />
                <NumericUpDown Minimum="5" Maximum="100" Value="{Binding LayoutEditor.RightMarginMm}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Columns by section (1–4). Section titles remain one-column." FontWeight="SemiBold"
                       Margin="0,8,0,0" />
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                <TextBlock Text="Family directory" />
                <NumericUpDown Minimum="1" Maximum="4" Value="{Binding LayoutEditor.FamilyDirectoryColumns}" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                <TextBlock Text="Person index" />
                <NumericUpDown Minimum="1" Maximum="4" Value="{Binding LayoutEditor.PersonIndexColumns}" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                <TextBlock Text="Occupation index" />
                <NumericUpDown Minimum="1" Maximum="4" Value="{Binding LayoutEditor.OccupationIndexColumns}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                <TextBlock Text="Property index" />
                <NumericUpDown Minimum="1" Maximum="4" Value="{Binding LayoutEditor.PropertyIndexColumns}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                <TextBlock Text="Hierarchical place index" />
                <NumericUpDown Minimum="1" Maximum="4" Value="{Binding LayoutEditor.HierarchicalPlaceIndexColumns}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                <TextBlock Text="Alphabetical place index" />
                <NumericUpDown Minimum="1" Maximum="4" Value="{Binding LayoutEditor.AlphabeticalPlaceIndexColumns}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Paragraph format styles" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="Font family/size, indentation, spacing, and alignment are saved in this project. Bold, italic, and underline remain defined by the entry template."
                       TextWrapping="Wrap" Opacity="0.8" />
            <ItemsControl ItemsSource="{Binding LayoutEditor.Styles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#808080" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,3">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                      <Grid ColumnDefinitions="2*,*,*,*,*,*,*" ColumnSpacing="7">
                        <StackPanel Grid.Column="0" Spacing="3">
                          <TextBlock Text="Font family" FontSize="11" />
                          <TextBox Text="{Binding FontFamily}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="Size (pt)" FontSize="11" />
                          <NumericUpDown Minimum="4" Maximum="144" Value="{Binding FontSizePt}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3">
                          <TextBlock Text="Indent (pt)" FontSize="11" />
                          <NumericUpDown Minimum="0" Maximum="1440" Value="{Binding IndentPt}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="3">
                          <TextBlock Text="Hanging (pt)" FontSize="11" />
                          <NumericUpDown Minimum="0" Maximum="1440" Value="{Binding HangingIndentPt}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="3">
                          <TextBlock Text="Space before" FontSize="11" />
                          <NumericUpDown Minimum="0" Maximum="1440" Value="{Binding SpaceBeforePt}" />
                        </StackPanel>
                        <StackPanel Grid.Column="5" Spacing="3">
                          <TextBlock Text="Space after" FontSize="11" />
                          <NumericUpDown Minimum="0" Maximum="1440" Value="{Binding SpaceAfterPt}" />
                        </StackPanel>
                        <StackPanel Grid.Column="6" Spacing="3">
                          <TextBlock Text="Alignment" FontSize="11" />
                          <ComboBox ItemsSource="{Binding AlignmentOptions}" SelectedItem="{Binding Alignment}" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Save the project to persist layout changes; export saves the project before publishing."
                       Opacity="0.8" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Privacy &amp; Filters">
        <ScrollViewer>
          <StackPanel Spacing="8" Margin="14">
            <TextBlock Text="Rules are applied to a detached export view; imported genealogy data is never edited."
                       TextWrapping="Wrap" />
            <Grid ColumnDefinitions="150,*,130,150,180,90,Auto" ColumnSpacing="6">
              <ComboBox Grid.Column="0" ItemsSource="{Binding RuleTargetKinds}" SelectedItem="{Binding RuleTargetKind}" />
              <TextBox Grid.Column="1" PlaceholderText="gedcom:person:I7" Text="{Binding RuleTargetId}" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding RuleActions}" SelectedItem="{Binding RuleAction}" />
              <TextBox Grid.Column="3" PlaceholderText="Field" Text="{Binding RuleField}" />
              <TextBox Grid.Column="4" PlaceholderText="Replacement / policy" Text="{Binding RuleValue}" />
              <NumericUpDown Grid.Column="5" Minimum="1" Maximum="9999"
                             Value="{Binding RuleOccurrence}" ToolTip.Tip="One-based occurrence, for fact rules only" />
              <Button Grid.Column="6" Content="Add rule" Command="{Binding AddRuleCommand}" />
            </Grid>
            <TextBlock Text="Fact rules use the Field as a fact type; occurrence is optional and one-based." Opacity="0.75" />
            <ListBox ItemsSource="{Binding ExportRules}" SelectedItem="{Binding SelectedRule}" MinHeight="240">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="12" Margin="3">
                    <TextBlock Text="{Binding Order}" Width="48" />
                    <TextBlock Text="{Binding TargetKind}" Width="70" />
                    <TextBlock Text="{Binding TargetId}" Width="220" />
                    <TextBlock Text="{Binding Action}" Width="90" />
                    <TextBlock Text="{Binding Field}" Width="120" />
                    <TextBlock Text="{Binding Value}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Move up" Command="{Binding MoveSelectedRuleUpCommand}" />
              <Button Content="Move down" Command="{Binding MoveSelectedRuleDownCommand}" />
              <Button Content="Apply form edits" Command="{Binding UpdateSelectedRuleCommand}" />
              <Button Content="Remove selected rule" Command="{Binding RemoveRuleCommand}" />
            </StackPanel>
            <TextBlock Text="People remaining after filters" FontWeight="SemiBold" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Refresh privacy and grouping preview" Command="{Binding RefreshGroupingCandidatesCommand}"
                      IsEnabled="{Binding IsNotBusy}" />
              <Button Content="Cancel" Command="{Binding RefreshGroupingCandidatesCancelCommand}"
                      IsEnabled="{Binding IsBusy}" />
              <TextBlock Text="Green: unchanged; amber: privacy fields changed." VerticalAlignment="Center" Opacity="0.8" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding PrivacyPeople}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="privacy-person" Classes.modified="{Binding HasChanges}"
                          BorderThickness="2" CornerRadius="4" Padding="7" Margin="0,2">
                    <StackPanel Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                        <TextBlock Text="{Binding TargetId}" Opacity="0.7" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Changes}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Field, StringFormat='{}{0}: changed'}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Grouping">
        <ScrollViewer>
          <StackPanel Spacing="9" Margin="14">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Refresh grouping preview" Command="{Binding RefreshGroupingCandidatesCommand}"
                      IsEnabled="{Binding IsNotBusy}" />
              <Button Content="Cancel" Command="{Binding RefreshGroupingCandidatesCancelCommand}"
                      IsEnabled="{Binding IsBusy}" />
              <TextBlock Text="Candidates require different parent and family-name groups."
                         VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock VerticalAlignment="Center" Text="Automatic acceptance threshold (0–100)" />
              <NumericUpDown Width="110" Minimum="0" Maximum="100"
                              Value="{Binding AutoAcceptThreshold, Mode=TwoWay}" />
            </StackPanel>
            <TextBlock Text="Manual merge" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="8">
              <ComboBox Grid.Column="0" ItemsSource="{Binding GroupingChoices}" SelectedItem="{Binding LeftGroupingChoice}" />
              <TextBlock Grid.Column="1" Text="↔" VerticalAlignment="Center" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding GroupingChoices}" SelectedItem="{Binding RightGroupingChoice}" />
              <Button Grid.Column="3" Content="Merge" Command="{Binding ManualMergeSelectedCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding GroupingSummaries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding GroupingCandidates}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#808080" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,3">
                    <StackPanel Spacing="5">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{Binding LeftSurname}" />
                        <TextBlock Text="↔" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding RightSurname}" />
                        <TextBlock Text="{Binding Score, StringFormat='Score: {0}/100'}" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding Status}" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Evidence}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Kind}" Opacity="0.8" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Button Content="Accept merge"
                                Command="{Binding $parent[Window].DataContext.AcceptCandidateCommand}"
                                CommandParameter="{Binding}" />
                        <Button Content="Keep separate"
                                Command="{Binding $parent[Window].DataContext.RejectCandidateCommand}"
                                CommandParameter="{Binding}" />
                        <TextBox Width="180" PlaceholderText="Override suggested name"
                                 Text="{Binding $parent[Window].DataContext.ManualGroupName}" />
                        <Button Content="Merge with this name"
                                Command="{Binding $parent[Window].DataContext.ManualMergeCandidateCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Saved decisions" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ItemsControl ItemsSource="{Binding GroupingDecisions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Action}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Diagnostics">
        <ScrollViewer>
          <StackPanel Spacing="8" Margin="14">
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            <TextBlock FontWeight="SemiBold" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Diagnostics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
