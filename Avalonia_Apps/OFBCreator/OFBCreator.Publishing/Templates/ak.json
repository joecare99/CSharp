{
  "schemaVersion": 1,
  "id": "ak",
  "entryRoot": "Family",
  "legend": [
    { "symbol": "*", "meaning": "geboren", "event": "Birth" },
    { "symbol": "~", "meaning": "getauft", "event": "Baptism" },
    { "symbol": "†", "meaning": "gestorben", "event": "Death" },
    { "symbol": "=", "meaning": "begraben", "event": "Burial" },
    { "symbol": "⚭", "meaning": "geheiratet", "event": "Mariage" },
    { "symbol": "o-o", "meaning": "uneheliche Verbindung", "event": "Partner" },
    { "symbol": "o/o", "meaning": "geschieden", "event": "Divorce" },
    { "symbol": "Ber.", "meaning": "Beruf", "event": "Occupation" },
    { "symbol": "Wh.", "meaning": "Wohnsitz", "event": "Residence" },
    { "symbol": "Ausb.", "meaning": "Ausbildung", "event": "Education" },
    { "symbol": "Bes.", "meaning": "Besitz", "event": "Property" },
    { "symbol": "Rel.", "meaning": "Religion", "event": "Religion" },
    { "symbol": "Mil.", "meaning": "Militär", "event": "Military" },
    { "symbol": "Ausw.", "meaning": "Auswanderung", "event": "Emigration" },
    { "symbol": "Einw.", "meaning": "Einwanderung", "event": "Immigration" },
    { "symbol": "Ebg.", "meaning": "Einbürgerung", "event": "Naturalization" },
    { "symbol": "Zähl.", "meaning": "Volkszählung", "event": "Census" },
    { "symbol": "Tit.", "meaning": "Titel", "event": "Title" },
    { "symbol": "Kdr.", "meaning": "Kinder", "event": null }
  ],
  "fragments": {
    "personNonVitalEvents": [
      {
        "kind": "forEach",
        "items": "person.events",
        "as": "personEvent",
        "template": [
          {
            "kind": "if",
            "condition": "personEvent.isListableNonVital",
            "then": [
              {
                "kind": "paragraph",
                "role": "family-data",
                "indent": 36,
                "content": [
                  {
                    "kind": "if",
                    "condition": "personEvent.date",
                    "then": [
                      { "kind": "field", "path": "personEvent.date" },
                      { "kind": "text", "value": ": " }
                    ]
                  },
                  {
                    "kind": "if",
                    "condition": "personEvent.symbol",
                    "then": [{ "kind": "field", "path": "personEvent.symbol" }]
                  },
                  {
                    "kind": "if",
                    "condition": "!personEvent.symbol",
                    "then": [{ "kind": "field", "path": "personEvent.eventName" }]
                  },
                  {
                    "kind": "if",
                    "condition": "personEvent.place",
                    "then": [
                      { "kind": "text", "value": " " },
                      { "kind": "field", "path": "personEvent.placePreposition" },
                      { "kind": "text", "value": " " },
                      {
                        "kind": "link",
                        "target": "personEvent.placeAnchor",
                        "content": [{ "kind": "field", "path": "personEvent.place" }]
                      }
                    ]
                  },
                  {
                    "kind": "if",
                    "condition": "personEvent.isOccupation",
                    "then": [
                      { "kind": "text", "value": ", " },
                      {
                        "kind": "link",
                        "target": "personEvent.occupationIndexAnchor",
                        "content": [{ "kind": "field", "path": "personEvent.additional" }]
                      }
                    ]
                  },
                  {
                    "kind": "if",
                    "condition": "!personEvent.isOccupation",
                    "then": [
                      {
                        "kind": "if",
                        "condition": "personEvent.additional",
                        "then": [
                          { "kind": "text", "value": ", " },
                          { "kind": "field", "path": "personEvent.additional" }
                        ]
                      }
                    ]
                  },
                  {
                    "kind": "if",
                    "condition": "personEvent.relatedPerson",
                    "then": [
                      { "kind": "text", "value": ", " },
                      {
                        "kind": "link",
                        "target": "personEvent.relatedPersonAnchor",
                        "content": [{ "kind": "field", "path": "personEvent.relatedPersonName" }]
                      }
                    ]
                  },
                  {
                    "kind": "if",
                    "condition": "personEvent.relatedFamily",
                    "then": [
                      { "kind": "text", "value": ", " },
                      {
                        "kind": "link",
                        "target": "personEvent.relatedFamilyAnchor",
                        "content": [{ "kind": "field", "path": "personEvent.relatedFamilyNumber" }]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "occupations": [
      {
        "kind": "forEach",
        "items": "person.occupations",
        "as": "occupation",
        "template": [
          {
            "kind": "paragraph",
            "role": "family-data",
            "indent": 36,
            "content": [
              { "kind": "field", "path": "occupation.date", "formatter": "gedcomDatePrefix" },
              {
                "kind": "link",
                "target": "occupation.indexAnchor",
                "content": [{ "kind": "field", "path": "occupation.name" }]
              }
            ]
          }
        ]
      }
    ],
    "parent": [
      {
        "kind": "paragraph",
        "role": "adult",
        "anchor": "person.anchor",
        "indent": 18,
        "content": [
          { "kind": "field", "path": "person.nameAk" },
          { "kind": "if", "condition": "person.akaNames", "then": [
            { "kind": "text", "value": " (" },
            { "kind": "field", "path": "person.akaNames" },
            { "kind": "text", "value": ")" }
          ] },
          {
            "kind": "link",
            "target": "person.indexAnchor",
            "content": [{ "kind": "text", "value": " [Index]" }]
          },
          { "kind": "if", "condition": "person.referenceNumber", "then": [
            { "kind": "text", "value": " <PN=" },
            { "kind": "field", "path": "person.referenceNumber" },
            { "kind": "text", "value": ">" }
          ] },
          { "kind": "if", "condition": "person.religion", "then": [
            { "kind": "text", "value": ", " },
            { "kind": "field", "path": "person.religion" }
          ] },
          { "kind": "field", "path": "person.vitalEventsAk" }
        ]
      },
      {
        "kind": "if",
        "condition": "person.showNonVitalEvents",
        "then": [{ "kind": "include", "fragment": "personNonVitalEvents" }]
      },
      { "kind": "include", "fragment": "occupations" }
    ]
  },
  "blocks": [
    {
      "kind": "paragraph",
      "role": "family-data",
      "anchor": "family.anchor",
      "spaceBefore": 6,
      "content": [
        { "kind": "text", "value": "⚭" },
        { "kind": "field", "path": "family.union", "formatter": "dateSuffix" }
      ]
    },
    {
      "kind": "forEach",
      "items": "family.parents",
      "as": "person",
      "template": [{ "kind": "include", "fragment": "parent" }]
    },
    {
      "kind": "if",
      "condition": "family.children.any",
      "then": [
        {
          "kind": "paragraph",
          "role": "children-header",
          "indent": 18,
          "content": [
            { "kind": "if", "condition": "family.children.one", "then": [{ "kind": "text", "value": "Kind:" }] },
            { "kind": "if", "condition": "!family.children.one", "then": [{ "kind": "text", "value": "Kinder:" }] }
          ]
        },
        {
          "kind": "forEach",
          "items": "family.children",
          "as": "child",
          "template": [
            {
              "kind": "paragraph",
              "role": "child",
              "anchor": "child.anchor",
              "indent": 54,
              "hangingIndent": 18,
              "content": [
                { "kind": "text", "value": "- " },
                { "kind": "field", "path": "child.nameAk" },
                { "kind": "field", "path": "child.birth", "formatter": "dateSuffix" },
                {
                  "kind": "link",
                  "target": "child.indexAnchor",
                  "content": [{ "kind": "text", "value": " [Index]" }]
                }
              ]
            },
            {
              "kind": "forEach",
              "items": "child.occupations",
              "as": "occupation",
              "template": [
                {
                  "kind": "paragraph",
                  "role": "family-data",
                  "indent": 36,
                  "content": [
                    { "kind": "field", "path": "occupation.date", "formatter": "gedcomDatePrefix" },
                    {
                      "kind": "link",
                      "target": "occupation.indexAnchor",
                      "content": [{ "kind": "field", "path": "occupation.name" }]
                    }
                  ]
                }
              ]
            },
            {
              "kind": "if",
              "condition": "child.showNonVitalEvents",
              "then": [
                { "kind": "include", "fragment": "personNonVitalEvents", "context": "child" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
