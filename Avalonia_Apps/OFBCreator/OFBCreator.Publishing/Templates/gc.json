{
  "schemaVersion": 1,
  "id": "gc",
  "entryRoot": "Family",
  "legend": [
    { "symbol": "*", "meaning": "geboren", "event": "Birth" },
    { "symbol": "≈", "meaning": "getauft", "event": "Baptism" },
    { "symbol": "†", "meaning": "gestorben", "event": "Death" },
    { "symbol": "∩", "meaning": "begraben", "event": "Burial" },
    { "symbol": "⚭", "meaning": "geheiratet", "event": "Mariage" },
    { "symbol": "o-o", "meaning": "uneheliche Verbindung", "event": "Partner" },
    { "symbol": "%", "meaning": "geschieden", "event": "Divorce" },
    { "symbol": "Ber.", "meaning": "Beruf", "event": "Occupation" },
    { "symbol": "Wh.", "meaning": "Wohnsitz", "event": "Residence" },
    { "symbol": "Ausb.", "meaning": "Ausbildung", "event": "Education" },
    { "symbol": "Bes.", "meaning": "Besitz", "event": "Property" },
    { "symbol": "Rel.", "meaning": "Religion", "event": "Religion" },
    { "symbol": "Mil.", "meaning": "Militär", "event": "Military" },
    { "symbol": "Ausw.", "meaning": "Auswanderung", "event": "Emigration" },
    { "symbol": "Einw.", "meaning": "Einwanderung", "event": "Immigration" },
    { "symbol": "Ebg.", "meaning": "Einbürgerung", "event": "Naturalization" },
    { "symbol": "Zähl.", "meaning": "Volkszählung", "event": "Census" },
    { "symbol": "Tit.", "meaning": "Titel", "event": "Title" },
    { "symbol": "Kdr.", "meaning": "Kinder", "event": null }
  ],
  "fragments": {
    "personEvent": [
      { "kind": "if", "condition": "!personEvent.isVital", "then": [
        { "kind": "field", "path": "personEvent.symbol", "lineBreakBefore": true },
        { "kind": "text", "value": " " }
      ] },
      { "kind": "if", "condition": "personEvent.isVital", "then": [
        { "kind": "field", "path": "personEvent.symbol" },
        { "kind": "text", "value": " " },
        { "kind": "field", "path": "personEvent.date" }
      ] },
      {
        "kind": "if",
        "condition": "!personEvent.isVital",
        "then": [
          {
            "kind": "field",
            "path": "personEvent.date"
          },
          {
            "kind": "text",
            "value": ": "
          },
          {
            "kind": "field",
            "path": "personEvent.symbol"
          }
        ]
      },
      { "kind": "if", "condition": "personEvent.place", "then": [
        { "kind": "text", "value": " in " },
        { "kind": "link", "target": "personEvent.placeAnchor", "content": [
          { "kind": "field", "path": "personEvent.place" }
        ] }
      ] },
      { "kind": "if", "condition": "personEvent.isOccupation", "then": [
        { "kind": "text", "value": " " },
        { "kind": "link", "target": "personEvent.occupationIndexAnchor", "content": [
          { "kind": "field", "path": "personEvent.additional" }
        ] }
      ] },
      { "kind": "if", "condition": "!personEvent.isOccupation", "then": [
        { "kind": "if", "condition": "personEvent.additional", "then": [
          { "kind": "text", "value": " " },
          { "kind": "field", "path": "personEvent.additional" }
        ] }
      ] },
      { "kind": "if", "condition": "personEvent.relatedPerson", "then": [
        { "kind": "text", "value": " " },
        { "kind": "link", "target": "personEvent.relatedPersonAnchor", "content": [
          { "kind": "field", "path": "personEvent.relatedPersonName" }
        ] }
      ] },
      { "kind": "if", "condition": "personEvent.relatedFamily", "then": [
        { "kind": "text", "value": " [" },
        { "kind": "link", "target": "personEvent.relatedFamilyAnchor", "content": [
          { "kind": "field", "path": "personEvent.relatedFamilyNumber" }
        ] },
        { "kind": "text", "value": "]" }
      ] },
      { "kind": "text", "value": ", " }
    ],
    "personEvents": [
      {
        "kind": "if",
        "condition": "person.vitalEventsGc",
        "then": [
          { "kind": "text", "value": ", " },
          {
            "kind": "forEach",
            "items": "person.events",
            "as": "personEvent",
            "template": [
              {
                "kind": "if",
                "condition": "personEvent.isVital",
                "then": [
                  {
                    "kind": "include",
                    "fragment": "personEvent"
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "personVitalEvents": [
      {
        "kind": "if",
        "condition": "person.vitalEventsGc",
        "then": [
          { "kind": "text", "value": ", " },
          {
            "kind": "forEach",
            "items": "person.events",
            "as": "personEvent",
            "template": [
              {
                "kind": "if",
                "condition": "personEvent.isVital",
                "then": [
                  { "kind": "include", "fragment": "personEvent" }
                ]
              }
            ]
          }
        ]
      }
    ],
    "personNonVitalEvents": [
      {
        "kind": "forEach",
        "items": "person.events",
        "as": "personEvent",
        "template": [
          {
            "kind": "if",
            "condition": "personEvent.isListableNonVital",
            "then": [
              {
                "kind": "paragraph",
                "role": "family-data",
                "indent": 36,
                "content": [
                  {
                    "kind": "if",
                    "condition": "personEvent.date",
                    "then": [
                      { "kind": "field", "path": "personEvent.date" },
                      { "kind": "text", "value": ": " }
                    ]
                  },
                  {
                    "kind": "if",
                    "condition": "personEvent.symbol",
                    "then": [{ "kind": "field", "path": "personEvent.symbol" }]
                  },
                  {
                    "kind": "if",
                    "condition": "!personEvent.symbol",
                    "then": [{ "kind": "field", "path": "personEvent.eventName" }]
                  },
                  {
                    "kind": "if",
                    "condition": "personEvent.place",
                    "then": [
                      { "kind": "text", "value": " " },
                      { "kind": "field", "path": "personEvent.placePreposition" },
                      { "kind": "text", "value": " " },
                      {
                        "kind": "link",
                        "target": "personEvent.placeAnchor",
                        "content": [{ "kind": "field", "path": "personEvent.place" }]
                      }
                    ]
                  },
                  {
                    "kind": "if",
                    "condition": "personEvent.isOccupation",
                    "then": [
                      { "kind": "text", "value": ", " },
                      {
                        "kind": "link",
                        "target": "personEvent.occupationIndexAnchor",
                        "content": [{ "kind": "field", "path": "personEvent.additional" }]
                      },
                      {
                        "kind": "if",
                        "condition": "personEvent.occupationEmployer",
                        "then": [
                          { "kind": "text", "value": " bei " },
                          { "kind": "field", "path": "personEvent.occupationEmployer" }
                        ]
                      }
                    ]
                  },
                  {
                    "kind": "if",
                    "condition": "!personEvent.isOccupation",
                    "then": [
                      {
                        "kind": "if",
                        "condition": "personEvent.additional",
                        "then": [
                          { "kind": "text", "value": ", " },
                          { "kind": "field", "path": "personEvent.additional" }
                        ]
                      }
                    ]
                  },
                  {
                    "kind": "if",
                    "condition": "personEvent.relatedPerson",
                    "then": [
                      { "kind": "text", "value": ", " },
                      {
                        "kind": "link",
                        "target": "personEvent.relatedPersonAnchor",
                        "content": [{ "kind": "field", "path": "personEvent.relatedPersonName" }]
                      }
                    ]
                  },
                  {
                    "kind": "if",
                    "condition": "personEvent.relatedFamily",
                    "then": [
                      { "kind": "text", "value": ", " },
                      {
                        "kind": "link",
                        "target": "personEvent.relatedFamilyAnchor",
                        "content": [{ "kind": "field", "path": "personEvent.relatedFamilyNumber" }]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "personDetails": [
      {
        "kind": "forEach",
        "items": "person.occupations",
        "as": "occupation",
        "template": [
          { "kind": "text", "value": ", " },
          { "kind": "field", "path": "occupation.date", "formatter": "gedcomDatePrefix" },
          { "kind": "link", "target": "occupation.indexAnchor", "italic": true, "content": [{ "kind": "field", "path": "occupation.name", "italic": true }] },
          { "kind": "if", "condition": "occupation.place", "then": [{ "kind": "text", "value": " in " }, { "kind": "link", "target": "occupation.placeAnchor", "content": [{ "kind": "field", "path": "occupation.place" }] }] },
          { "kind": "if", "condition": "occupation.employer", "then": [{ "kind": "text", "value": " bei " }, { "kind": "field", "path": "occupation.employer" }] }
        ]
      },
      {
        "kind": "forEach",
        "items": "person.properties",
        "as": "property",
        "template": [
          { "kind": "text", "value": " [" },
          { "kind": "field", "path": "property.date", "formatter": "gedcomDatePrefix" },
          { "kind": "link", "target": "property.indexAnchor", "content": [{ "kind": "field", "path": "property.name" }] },
          { "kind": "if", "condition": "property.place", "then": [{ "kind": "text", "value": " in " }, { "kind": "link", "target": "property.placeAnchor", "content": [{ "kind": "field", "path": "property.place" }] }] },
          { "kind": "text", "value": "]" }
        ]
      },
      { "kind": "if", "condition": "person.residence", "then": [{ "kind": "text", "value": " Wohnort: " }, { "kind": "link", "target": "person.residenceAnchor", "content": [{ "kind": "field", "path": "person.residence" }] }] }
    ],
    "parent": [
      {
        "kind": "paragraph",
        "role": "adult",
        "anchor": "person.anchor",
        "indent": 36,
        "hangingIndent": 18,
        "content": [
          { "kind": "text", "value": "•\t" },
          { "kind": "link", "target": "person.indexAnchor", "bold": true, "content": [{ "kind": "field", "path": "person.nameGc", "bold": true }] },
          { "kind": "if", "condition": "person.akaNames", "then": [
            { "kind": "text", "value": " (" },
            { "kind": "field", "path": "person.akaNames" },
            { "kind": "text", "value": ")" }
          ] },
          {
            "kind": "if",
            "condition": "person.parentFamily",
            "then": [
              { "kind": "text", "value": " <" },
              { "kind": "link", "target": "person.parentFamily.anchor", "content": [{ "kind": "field", "path": "person.parentFamily.number" }] },
              { "kind": "text", "value": ">" }
            ]
          },
          {
            "kind": "if",
            "condition": "person.parentFamilyTokens.any",
            "then": [
              {
                "kind": "text",
                "value": " ["
              },
              {
                "kind": "forEach",
                "items": "person.parentFamilyTokens",
                "as": "familyToken",
                "template": [
                  {
                    "kind": "link",
                    "target": "familyToken.anchor",
                    "content": [
                      {
                        "kind": "field",
                        "path": "familyToken.text"
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "text",
                "value": "]"
              }
            ]
          },
          {
            "kind": "if",
            "condition": "person.referenceNumber",
            "then": [
              { "kind": "text", "value": "<PN=", "lineBreakBefore": true },
              { "kind": "field", "path": "person.referenceNumber" },
              { "kind": "text", "value": ">" }
            ]
          },
          {
            "kind": "if",
            "condition": "person.religion",
            "then": [
              { "kind": "text", "value": ", " },
              { "kind": "field", "path": "person.religion" }
            ]
          },
          { "kind": "include", "fragment": "personEvents" },
          { "kind": "field", "path": "person.additionalLifeDataGc" },
          { "kind": "include", "fragment": "personDetails" }
        ]
      },
      {
        "kind": "if",
        "condition": "person.showNonVitalEvents",
        "then": [{ "kind": "include", "fragment": "personNonVitalEvents" }]
      }
    ]
  },
  "blocks": [
    {
      "kind": "paragraph",
      "role": "family-data",
      "anchor": "family.anchor",
      "spaceBefore": 6,
      "content": [
        {
          "kind": "field",
          "path": "family.number",
          "bold": true
        },
        {
          "kind": "text",
          "value": " "
        },
        {
          "kind": "field",
          "path": "family.marriageMark"
        },
        {
          "kind": "field",
          "path": "family.marriageDate",
          "formatter": "dateSuffix"
        },
        {
          "kind": "if",
          "condition": "family.marriagePlaceShort",
          "then": [
            {
              "kind": "text",
              "value": " in "
            },
            {
              "kind": "link",
              "target": "family.marriagePlaceAnchor",
              "content": [
                {
                  "kind": "field",
                  "path": "family.marriagePlaceShort"
                }
              ]
            }
          ]
        },
        {
          "kind": "forEach",
          "items": "family.properties",
          "as": "property",
          "template": [
            {
              "kind": "text",
              "value": " ["
            },
            {
              "kind": "link",
              "target": "property.indexAnchor",
              "content": [
                {
                  "kind": "field",
                  "path": "property.name"
                }
              ]
            },
            {
              "kind": "text",
              "value": "]"
            }
          ]
        }
      ]
    },
    {
      "kind": "forEach",
      "items": "family.parents",
      "as": "person",
      "template": [
        {
          "kind": "include",
          "fragment": "parent"
        }
      ]
    },
    {
      "kind": "if",
      "condition": "family.children.any",
      "then": [
        {
          "kind": "paragraph",
          "role": "children-header",
          "indent": 18,
          "content": [
            { "kind": "text", "value": "•\t" },
            {
              "kind": "if",
              "condition": "family.children.one",
              "then": [{ "kind": "text", "value": "Kind:" }]
            },
            {
              "kind": "if",
              "condition": "!family.children.one",
              "then": [{ "kind": "text", "value": "Kinder:" }]
            }
          ]
        },
        {
          "kind": "forEach",
          "items": "family.children",
          "as": "person",
          "template": [
            {
              "kind": "paragraph",
              "role": "child",
              "anchor": "person.anchor",
              "indent": 54,
              "hangingIndent": 18,
              "content": [
                {
                  "kind": "field",
                  "path": "person.ordinal",
                  "formatter": "ordinal"
                },
                {
                  "kind": "text",
                  "value": " "
                },
                {
                  "kind": "link",
                  "target": "person.indexAnchor",
                  "bold": true,
                  "content": [
                    {
                      "kind": "field",
                      "path": "person.nameGc",
                      "bold": true
                    }
                  ]
                },
                    {
                      "kind": "if",
                      "condition": "person.parentFamilyTokens.any",
                      "then": [{ "kind": "include", "fragment": "personVitalEvents" }]
                    },
                    {
                      "kind": "if",
                      "condition": "!person.parentFamilyTokens.any",
                      "then": [{ "kind": "include", "fragment": "personEvents" }]
                    },
                {
                  "kind": "if",
                  "condition": "person.parentFamilyTokens.any",
                  "then": [
                    {
                      "kind": "text",
                      "value": " ["
                    },
                    {
                      "kind": "forEach",
                      "items": "person.parentFamilyTokens",
                      "as": "familyToken",
                      "template": [
                        {
                          "kind": "link",
                          "target": "familyToken.anchor",
                          "content": [
                            {
                              "kind": "field",
                              "path": "familyToken.text"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "value": "]"
                    }
                  ]
                }
              ]
            },
            {
              "kind": "if",
              "condition": "person.showNonVitalEvents",
              "then": [{ "kind": "include", "fragment": "personNonVitalEvents" }]
            }
          ]
        }
      ]
    }
  ]
}
