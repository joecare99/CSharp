<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:models="using:Avln_ImageEditor.Controls.Models"
			 xmlns:vm="using:Avln_ImageEditor.Controls.ViewModels"
			 xmlns:views="using:Avln_ImageEditor.Controls.Views"
			 x:Class="Avln_ImageEditor.Controls.Views.ImageEditorControl"
			 x:DataType="vm:ImageEditorViewModel"
			 d:DesignHeight="720"
			 d:DesignWidth="1080"
			 mc:Ignorable="d">
  <Grid RowDefinitions="Auto,*"
		Background="#202126">
	<Border Grid.Row="0"
			Padding="12"
			Background="#2B2D33"
			BorderBrush="#40424A"
			BorderThickness="0,0,0,1">
	  <StackPanel Spacing="8">
		<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
		  <StackPanel Orientation="Horizontal" Spacing="8">
		  <Button Command="{Binding SelectToolCommand}"
				  CommandParameter="{x:Static models:ImageEditorTool.Select}"
				  Content="Select" />
		  <CheckBox x:Name="BrushMode" VerticalAlignment="Center" Content="Brush (1 px)"
					IsEnabled="{Binding HasDocument}" />
		  <Button Command="{Binding SelectToolCommand}"
				  CommandParameter="{x:Static models:ImageEditorTool.Eraser}"
				  Content="Eraser*" IsEnabled="False" />
		  <Button Command="{Binding SelectToolCommand}"
				  CommandParameter="{x:Static models:ImageEditorTool.Fill}"
				  Content="Fill*" IsEnabled="False" />
		  <Button Command="{Binding RotateRightCommand}" Content="Rotate 90° right" />
		  <Button Command="{Binding RotateLeftCommand}" Content="Rotate left" />
		  <Button Command="{Binding Rotate180Command}" Content="Rotate 180°" />
		  <Button Command="{Binding FlipHorizontalCommand}" Content="Flip horizontal" />
		  <Button Command="{Binding FlipVerticalCommand}" Content="Flip vertical" />
		  <Button Command="{Binding InvertColorsCommand}" Content="Invert colors" />
		  <Button Command="{Binding ConvertToGrayscaleCommand}" Content="Convert to grayscale" />
		  <Button Command="{Binding UndoCommand}" Content="Undo" />
		  <Button Command="{Binding RedoCommand}" Content="Redo" />
		  </StackPanel>
		</ScrollViewer>

		<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
		  <StackPanel Orientation="Horizontal" Spacing="8">
			<CheckBox x:Name="SampleColorMode" VerticalAlignment="Center" Content="Sample image color"
					  IsEnabled="{Binding HasDocument}" />
			<TextBlock VerticalAlignment="Center" Foreground="#F2F2F2" Text="{Binding SampledColorSummary}" />
			<StackPanel>
			  <TextBlock Foreground="#F2F2F2" Text="Hex #AARRGGBB" />
			  <TextBox x:Name="SampledColorHexInput" Width="140" IsReadOnly="True"
					   AutomationProperties.Name="Sampled color hex, alpha red green blue"
					   Text="{Binding SampledColorHex, Mode=OneWay}" />
			</StackPanel>
		  </StackPanel>
		</ScrollViewer>

		<Border Padding="8" BorderBrush="#707480" BorderThickness="1" CornerRadius="4">
		  <StackPanel Spacing="6">
			<TextBlock Foreground="#F2F2F2" FontWeight="SemiBold" Text="Crop by pixel coordinates or drag selection" />
			<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
			  <StackPanel Orientation="Horizontal" Spacing="8">
				<CheckBox x:Name="DragCropMode" VerticalAlignment="Bottom" Content="Drag crop selection" IsEnabled="{Binding HasDocument}" />
				<StackPanel><TextBlock Foreground="#F2F2F2" Text="X (from left)" /><TextBox x:Name="CropXInput" Width="90" AutomationProperties.Name="Crop X from left in pixels" Text="{Binding CropX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
				<StackPanel><TextBlock Foreground="#F2F2F2" Text="Y (from top)" /><TextBox x:Name="CropYInput" Width="90" AutomationProperties.Name="Crop Y from top in pixels" Text="{Binding CropY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
				<StackPanel><TextBlock Foreground="#F2F2F2" Text="Width (px)" /><TextBox x:Name="CropWidthInput" Width="90" AutomationProperties.Name="Crop width in pixels" Text="{Binding CropWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
				<StackPanel><TextBlock Foreground="#F2F2F2" Text="Height (px)" /><TextBox x:Name="CropHeightInput" Width="90" AutomationProperties.Name="Crop height in pixels" Text="{Binding CropHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
				<Button VerticalAlignment="Bottom" Command="{Binding ApplyCropCommand}" Content="Apply crop" />
				<Button x:Name="ResetCropCoordinatesButton" VerticalAlignment="Bottom" Command="{Binding ResetCropCoordinatesCommand}" Content="Reset crop coordinates" />
			  </StackPanel>
			</ScrollViewer>
			<TextBlock Foreground="#FFB4AB" Text="{Binding CropError}" TextWrapping="Wrap" />
		  </StackPanel>
		</Border>

		<DockPanel LastChildFill="True">
		<ScrollViewer DockPanel.Dock="Right"
					  HorizontalScrollBarVisibility="Auto"
					  VerticalScrollBarVisibility="Disabled">
		<StackPanel
					Orientation="Horizontal"
					Spacing="8">
		  <Button Command="{Binding ZoomOutCommand}"
				  Content="-" />
		  <TextBlock MinWidth="56"
					 VerticalAlignment="Center"
					 Foreground="#F2F2F2"
					 Text="{Binding ZoomSummary}"
					 TextAlignment="Center" />
		  <Button Command="{Binding ZoomInCommand}"
				  Content="+" />
		  <Button Command="{Binding ResetZoomCommand}"
				  Content="100%" />
		  <Button x:Name="FitImageButton"
				  Content="Fit (min 10%)"
				  AutomationProperties.Name="Fit image to current viewport, minimum zoom 10 percent; large images may remain clipped"
				  ToolTip.Tip="Fit to the current viewport (10%–800%). Large images may not fit at the minimum zoom."
				  IsEnabled="{Binding HasDocument}"
				  Click="FitImageClick" />
		  <Button Command="{Binding ClearDocumentCommand}"
				  Content="Clear" />
		</StackPanel>
		</ScrollViewer>

		<StackPanel HorizontalAlignment="Center"
					Orientation="Horizontal"
					Spacing="16">
		  <TextBlock VerticalAlignment="Center"
					 Foreground="#D7D9E0"
					 Text="{Binding DocumentSummary}" />
		  <TextBlock VerticalAlignment="Center"
					 Foreground="#9EA3B0"
					 Text="* Not implemented" />
		</StackPanel>
		</DockPanel>
	  </StackPanel>
	</Border>

	<Grid Grid.Row="1">
	  <Border Margin="16"
			  Background="#15161A"
			  BorderBrush="#343741"
			  BorderThickness="1">
		<ScrollViewer x:Name="ImageScrollViewer" UseLayoutRounding="False" HorizontalScrollBarVisibility="Visible"
					  VerticalScrollBarVisibility="Visible">
		  <Grid UseLayoutRounding="False">
			<LayoutTransformControl HorizontalAlignment="Center"
									VerticalAlignment="Center"
									UseLayoutRounding="False">
			  <LayoutTransformControl.LayoutTransform>
				<ScaleTransform ScaleX="{Binding ZoomFactor}"
								ScaleY="{Binding ZoomFactor}" />
			  </LayoutTransformControl.LayoutTransform>
			  <Grid x:Name="ImageSurface" UseLayoutRounding="False" Focusable="True" Background="Transparent"
					Width="{Binding ActiveDocument.PixelSize.Width, TargetNullValue=0, FallbackValue=0}"
					Height="{Binding ActiveDocument.PixelSize.Height, TargetNullValue=0, FallbackValue=0}">
				<Border x:Name="TransparencyBackground"
						IsHitTestVisible="False"
						IsVisible="{Binding HasDocument}">
				  <Border.Background>
					<DrawingBrush TileMode="Tile" DestinationRect="0,0,16,16">
					  <DrawingBrush.Drawing>
						<DrawingGroup>
						  <GeometryDrawing Brush="#383B42" Geometry="M0,0 H16 V16 H0 Z" />
						  <GeometryDrawing Brush="#4A4D55" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
						</DrawingGroup>
					  </DrawingBrush.Drawing>
					</DrawingBrush>
				  </Border.Background>
				</Border>
				<Image x:Name="EditorImage" Source="{Binding ActiveDocument.DisplayImage}" Stretch="Fill" />
				<views:CropPreviewOverlay x:Name="CropPreviewOutline"
										  IsHitTestVisible="False"
										  IsVisible="{Binding ShowCropPreview}"
										  CropRectangle="{Binding CropPreview}" Zoom="{Binding ZoomFactor}" />
			  </Grid>
			</LayoutTransformControl>
		  </Grid>
		</ScrollViewer>
	  </Border>

	  <Border Padding="20"
			  HorizontalAlignment="Center"
			  VerticalAlignment="Center"
			  Background="#CC202126"
			  CornerRadius="8"
			  IsVisible="{Binding !HasDocument}">
		<StackPanel Spacing="8">
		  <TextBlock HorizontalAlignment="Center"
					 FontSize="22"
					 FontWeight="SemiBold"
					 Foreground="#F2F2F2"
					 Text="Image Editor" />
		  <TextBlock HorizontalAlignment="Center"
					 Foreground="#B8BCC8"
					 Text="Open an image in the host application to start." />
		</StackPanel>
	  </Border>
	</Grid>
  </Grid>
</UserControl>
