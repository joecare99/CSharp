<Project>
  <PropertyGroup>
	<_ImageEditorHasArtifactRoot Condition="'$(HostArtifactRoot)' != ''">true</_ImageEditorHasArtifactRoot>
  </PropertyGroup>
  <Import Project="..\Solution.props" />
  <PropertyGroup>
	<UpDir>..\$(UpDir)</UpDir>
	<BaseOutputPath Condition="'$(_ImageEditorHasArtifactRoot)' != 'true'">$(UpDir)\..\bin\$(MSBuildProjectName)\</BaseOutputPath>
	<BaseIntermediateOutputPath Condition="'$(_ImageEditorHasArtifactRoot)' != 'true'">$(UpDir)\..\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
