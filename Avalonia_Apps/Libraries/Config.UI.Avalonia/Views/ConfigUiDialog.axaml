<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:configUi="using:Config.UI.Avalonia.Views"
        xmlns:vm="using:Config.UI.Avalonia.ViewModels"
        x:Class="Config.UI.Avalonia.Views.ConfigUiDialog"
        x:DataType="vm:ConfigUiViewModel"
        Width="760"
        Height="560"
        MinWidth="600"
        MinHeight="420"
        Title="{Binding DialogTitle}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="12" RowDefinitions="*,Auto,Auto" RowSpacing="12">
    <configUi:ConfigUiView ShowSectionActions="False" DataContext="{Binding}" />
    <ContentControl x:Name="HostContentPresenter" Grid.Row="1" />
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                 IsVisible="{Binding IsBusy}" Text="Please wait for the settings operation to finish." />
      <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <Button Content="OK" IsEnabled="{Binding !IsBusy}" Click="OnOkClick" />
      <Button Content="Apply"
              IsEnabled="{Binding CanApplyChanges}"
              Click="OnApplyClick" />
      <Button Content="Cancel" IsEnabled="{Binding !IsBusy}" Click="OnCancelClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
