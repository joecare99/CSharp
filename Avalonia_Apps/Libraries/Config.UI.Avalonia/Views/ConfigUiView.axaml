<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:propertyEditor="using:Property.Editor.Avalonia.Views"
             xmlns:vm="using:Config.UI.Avalonia.ViewModels"
             x:Class="Config.UI.Avalonia.Views.ConfigUiView"
             x:DataType="vm:ConfigUiViewModel">
  <Grid ColumnDefinitions="180,*" ColumnSpacing="8">
    <ListBox IsEnabled="{Binding !IsBusy}"
             ItemsSource="{Binding Sections}"
             SelectedItem="{Binding SelectedSection, Mode=TwoWay}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Section.DisplayName}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="8">
      <StackPanel Spacing="2">
        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedSection.Section.DisplayName}" />
        <TextBlock Opacity="0.75" Text="{Binding SelectedSection.Section.Description}" TextWrapping="Wrap" />
        <TextBlock FontSize="11" Opacity="0.75" Text="{Binding SelectedContextDisplay}" TextWrapping="Wrap" />
      </StackPanel>
      <Grid Grid.Row="1" IsEnabled="{Binding !IsBusy}">
        <propertyEditor:PropertyEditorPanel DataContext="{Binding PropertyEditor}" />
      </Grid>
      <StackPanel x:Name="SectionActionsPanel"
                  Grid.Row="2"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="6">
        <Button Content="Load" Command="{Binding LoadCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button Content="Reset" Command="{Binding ResetCommand}" IsEnabled="{Binding CanSave}" />
        <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
      </StackPanel>
      <StackPanel Grid.Row="3" Spacing="6">
        <TextBlock Text="{Binding OperationMessage}" TextWrapping="Wrap" />
        <Button Content="Retry discard/reload"
                HorizontalAlignment="Left"
                IsVisible="{Binding NeedsReloadRecovery}"
                IsEnabled="{Binding !IsBusy}"
                Command="{Binding RetryFailedReloadsCommand}"
                ToolTip.Tip="Retries failed discard and reload operations. Discarded changes cannot be recovered." />
      </StackPanel>
      <TextBlock Grid.Row="4"
                 Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                 Text="{Binding ErrorMessage}"
                 TextWrapping="Wrap" />
    </Grid>
  </Grid>
</UserControl>
