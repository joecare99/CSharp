<Project>
	<Import Project="..\Solution.props" />
	<PropertyGroup>
		<UpDir>..\$(UpDir)</UpDir>
		<BaseOutputPath Condition="'$(HostArtifactRoot)' != ''">$(HostArtifactRoot)\bin\$(MSBuildProjectName)\</BaseOutputPath>
		<BaseIntermediateOutputPath Condition="'$(HostArtifactRoot)' != ''">$(HostArtifactRoot)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
		<BaseOutputPath Condition="'$(HostArtifactRoot)' == ''">$(UpDir)\..\bin\$(MSBuildProjectName)\</BaseOutputPath>
		<BaseIntermediateOutputPath Condition="'$(HostArtifactRoot)' == ''">$(UpDir)\..\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
	</PropertyGroup>
  <ItemGroup>
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>

</Project>