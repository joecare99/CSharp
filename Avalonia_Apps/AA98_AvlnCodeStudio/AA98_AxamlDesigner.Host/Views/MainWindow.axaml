<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AA98_AxamlDesigner.Host.ViewModels"
        xmlns:designer="using:AA98_AvlnCodeStudio.AxamlDesigner.UI.Views"
        x:Class="AA98_AxamlDesigner.Host.Views.MainWindow"
        x:DataType="vm:AxamlDesignerHostViewModel"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="560">
  <Grid ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="0" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>
  <DockPanel Grid.Row="0"
             MinHeight="0"
             LastChildFill="True">
    <Grid DockPanel.Dock="Top"
          Margin="12,12,12,8"
          RowDefinitions="Auto,Auto,Auto"
          RowSpacing="6">
      <Grid Grid.Row="0"
            ColumnDefinitions="*,Auto,Auto,Auto"
            ColumnSpacing="8">
        <TextBox Grid.Column="0"
                 PlaceholderText="AXAML file path"
                 Text="{Binding FilePath, Mode=TwoWay}" />
        <Button Grid.Column="1"
                Content="Browse..."
                Click="OnBrowseRequested" />
        <Button Grid.Column="2"
                Content="Open"
                Click="OnOpenPathRequested" />
        <Button Grid.Column="3"
                Content="Save"
                Click="OnSaveRequested" />
      </Grid>
      <Grid Grid.Row="1"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="8">
        <TextBox Grid.Column="0"
                 PlaceholderText="Project/workspace directory (required for multi-file changes)"
                 Text="{Binding WorkspacePathInput, Mode=TwoWay}" />
        <Button Grid.Column="1"
                Content="Select workspace..."
                Click="OnWorkspaceBrowseRequested" />
        <Button Grid.Column="2"
                Content="Use path"
                Command="{Binding ApplyWorkspaceContextCommand}" />
      </Grid>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
        <Button Content="Undo workspace change"
                Command="{Binding UndoWorkspaceChangeCommand}" />
        <Button Content="Redo workspace change"
                Command="{Binding RedoWorkspaceChangeCommand}" />
      </StackPanel>
    </Grid>

    <designer:AxamlDesignerView Margin="12,0,12,8"
                                MinHeight="0"
                                x:Name="DesignerView"
                                DataContext="{Binding Designer}" />
  </DockPanel>
  <Border Grid.Row="1"
          Height="28"
          Padding="8,3"
          Background="#2D2D30"
          BorderBrush="#555555"
          BorderThickness="0,1,0,0">
    <StackPanel Orientation="Horizontal" Spacing="16">
      <TextBlock Text="{Binding WorkspaceContextStatus}"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding StatusText}"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Border>
  </Grid>
</Window>
