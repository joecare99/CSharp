<Project>
  <Import Project="..\AA98_AvlnCodeStudio.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Configurations>Debug;Release;DesktopOnly</Configurations>
  </PropertyGroup>
  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.props" />
  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" />

  <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '9.0.100'))">
    <TargetFrameworks>$(TargetFrameworks);net9.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0.100'))">
    <TargetFrameworks>$(TargetFrameworks);net10.0</TargetFrameworks>
  </PropertyGroup>


  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Locator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageReference Update="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" />
    <PackageReference Update="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="4.14.0" />
    <PackageReference Update="Microsoft.CodeAnalysis.CSharp.Features" VersionOverride="4.14.0" />
    <PackageReference Update="Microsoft.CodeAnalysis.Workspaces.MSBuild" VersionOverride="4.14.0" />
    <PackageReference Include="Microsoft.Build" VersionOverride="17.14.28" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" VersionOverride="17.14.28" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" VersionOverride="17.14.28" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" VersionOverride="17.14.28" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Update="Microsoft.NET.StringTools" VersionOverride="17.14.28" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" VersionOverride="10.0.14" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Xml" VersionOverride="10.0.14" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AA98_AvlnCodeStudio.Base\AA98_AvlnCodeStudio.Base.csproj" />
    <ProjectReference Include="..\AA98_AvlnCodeStudio.Base.AI\AA98_AvlnCodeStudio.Base.AI.csproj" />
    <ProjectReference Include="..\AA98_AvlnCodeStudio.Host.Mcp\AA98_AvlnCodeStudio.Host.Mcp.csproj" />
    <ProjectReference Include="..\AA98_AvlnCodeStudio.Base.Building\AA98_AvlnCodeStudio.Base.Building.csproj" />
    <ProjectReference Include="..\AA98_AvlnCodeStudio.Base.UI\AA98_AvlnCodeStudio.Base.UI.csproj" />
    <ProjectReference Include="..\AA98_AvlnCodeStudio.Base.OS\AA98_AvlnCodeStudio.Base.OS.csproj" />
    <ProjectReference Include="..\AA98_AvlnCodeStudio.Base.Versioning\AA98_AvlnCodeStudio.Base.Versioning.csproj" />
    <ProjectReference Include="..\AA98_AvlnCodeStudio.Versioning.Svn\AA98_AvlnCodeStudio.Versioning.Svn.csproj" />
    <ProjectReference Include="..\AA98_AvlnCodeStudio.Base.Testing\AA98_AvlnCodeStudio.Base.Testing.csproj" />
    <ProjectReference Include="..\AA98_AvlnCodeStudio.Base.Debugging\AA98_AvlnCodeStudio.Base.Debugging.csproj" />
    <ProjectReference Include="..\AA98_AvlnCodeStudio.Editor\AA98_AvlnCodeStudio.Editor.csproj" />
    <ProjectReference Include="..\AA98_AvlnCodeStudio.Diagnostics.UI\AA98_AvlnCodeStudio.Diagnostics.UI.csproj" />
    <ProjectReference Include="..\..\Libraries\Config.Service\Config.Service.csproj" />
    <ProjectReference Include="..\..\Libraries\Config.UI.ConfigService\Config.UI.ConfigService.csproj" />
    <ProjectReference Include="..\..\Libraries\Config.UI.Avalonia\Config.UI.Avalonia.csproj" />
    <ProjectReference Include="..\..\Libraries\Project.Explorer.FileSystem\Project.Explorer.FileSystem.csproj" />
    <ProjectReference Include="..\..\Libraries\Project.Explorer.Avalonia\Project.Explorer.Avalonia.csproj" />
    <ProjectReference Include="..\AA98_AvlnCodeStudio.Model\AA98_AvlnCodeStudio.Model.csproj" />
    <ProjectReference Include="..\AA98_AvlnCodeStudio.Config.Secrets\AA98_AvlnCodeStudio.Config.Secrets.csproj" />
    <ProjectReference Include="..\AA98_AvlnCodeStudio.AxamlDesigner.UI\AA98_AvlnCodeStudio.AxamlDesigner.UI.csproj" />
    <ProjectReference Include="..\..\Libraries\Avln_CommonDialogs.Avalonia\Avln_CommonDialogs.Avalonia.csproj" />
    <ProjectReference Include="..\AA98_AvlnCodeStudio.Planning.Core\AA98_AvlnCodeStudio.Planning.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\AA98_AvlnCodeStudio.Building.Workbench\AA98_AvlnCodeStudio.Building.Workbench.csproj" />
    <ProjectReference Include="..\AA98_AvlnCodeStudio.Versioning.Git\AA98_AvlnCodeStudio.Versioning.Git.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Update="Avalonia" Version="12.1.4" />
    <PackageVersion Update="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Update="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Update="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>
</Project>
