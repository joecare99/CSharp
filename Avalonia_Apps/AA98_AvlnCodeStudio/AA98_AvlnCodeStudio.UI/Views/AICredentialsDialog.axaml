<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AA98_AvlnCodeStudio.UI.ViewModels"
        x:Class="AA98_AvlnCodeStudio.UI.Views.AICredentialsDialog"
        x:DataType="vm:MainWindowViewModel"
        Width="520"
        MinWidth="420"
        MaxHeight="720"
        SizeToContent="Height"
        Title="AI Credentials"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="The key is session-only until explicitly saved to the selected credential manager. Save and delete take effect immediately."
               TextWrapping="Wrap" />
    <TextBlock Text="Credential manager" />
    <TextBlock Text="{Binding CredentialProviderDisplay}" />
    <TextBlock Text="Endpoint scope" />
    <TextBlock Text="{Binding AiEndpoint}" TextWrapping="Wrap" />
    <TextBlock Text="Session API key" />
    <TextBox PlaceholderText="{Binding AIChatApiKeyPlaceholderText}"
             AutomationProperties.Name="Session API key"
             Text="{Binding AiApiKey, Mode=TwoWay}"
             IsEnabled="{Binding !CredentialOperationBusy}"
             PasswordChar="*" />
    <StackPanel IsVisible="{Binding IsEncryptedVaultSelected}" Spacing="6">
      <TextBlock Text="Local encrypted vault" FontWeight="SemiBold" />
      <TextBlock Text="{Binding EncryptedVaultPath}" TextWrapping="Wrap" Opacity="0.8" />
      <StackPanel IsVisible="{Binding EncryptedVaultNeedsInitialization}" Spacing="6">
        <TextBlock Text="Choose a passphrase of at least 12 characters. It cannot be recovered if lost."
                   TextWrapping="Wrap" />
        <TextBlock Text="Vault passphrase" />
        <TextBox Name="VaultPassphrase"
                 PlaceholderText="Vault passphrase"
                 AutomationProperties.Name="Vault passphrase"
                 IsEnabled="{Binding !CredentialOperationBusy}"
                 PasswordChar="*" />
        <TextBlock Text="Confirm vault passphrase" />
        <TextBox Name="VaultPassphraseConfirmation"
                 PlaceholderText="Confirm passphrase"
                 AutomationProperties.Name="Confirm vault passphrase"
                 IsEnabled="{Binding !CredentialOperationBusy}"
                 PasswordChar="*" />
        <Button Content="Create encrypted vault"
                HorizontalAlignment="Left"
                IsEnabled="{Binding !CredentialOperationBusy}"
                Click="OnInitializeVaultClick" />
      </StackPanel>
      <StackPanel IsVisible="{Binding EncryptedVaultNeedsUnlock}" Spacing="6">
        <TextBlock Text="Vault passphrase" />
        <TextBox Name="VaultUnlockPassphrase"
                 PlaceholderText="Vault passphrase"
                 AutomationProperties.Name="Vault passphrase"
                 IsEnabled="{Binding !CredentialOperationBusy}"
                 PasswordChar="*" />
        <Button Content="Unlock vault"
                HorizontalAlignment="Left"
                IsEnabled="{Binding !CredentialOperationBusy}"
                Click="OnUnlockVaultClick" />
      </StackPanel>
      <Button IsVisible="{Binding EncryptedVaultUnlocked}"
              Content="Lock vault and clear session API key"
              HorizontalAlignment="Left"
              IsEnabled="{Binding !CredentialOperationBusy}"
              Click="OnLockVaultClick" />
    </StackPanel>
    <UniformGrid Columns="2" Rows="2">
      <Button Content="Save key" Command="{Binding SaveAICredentialCommand}" />
      <Button Content="Load key" Command="{Binding LoadAICredentialCommand}" />
      <Button Content="Delete key" Command="{Binding DeleteAICredentialCommand}" />
      <Button Content="Check manager" Command="{Binding RefreshCredentialProviderStatusCommand}" />
    </UniformGrid>
    <TextBlock Text="{Binding CredentialStorageStatus}"
               AutomationProperties.LiveSetting="Polite"
               Opacity="0.8"
               TextWrapping="Wrap" />
    <TextBlock IsVisible="{Binding CredentialOperationBusy}" Text="Please wait for the credential operation to finish before closing. Save and delete may already have taken effect."
               TextWrapping="Wrap" />
    <Button Content="Close" HorizontalAlignment="Right" IsEnabled="{Binding !CredentialOperationBusy}" Click="OnCloseClick" />
   </StackPanel>
  </ScrollViewer>
</Window>
