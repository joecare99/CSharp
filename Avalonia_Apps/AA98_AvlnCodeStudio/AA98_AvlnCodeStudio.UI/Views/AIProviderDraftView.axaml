<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AA98_AvlnCodeStudio.UI.Configuration"
             x:Class="AA98_AvlnCodeStudio.UI.Views.AIProviderDraftView"
             x:DataType="vm:AIProviderDraftViewModel"
             IsVisible="{Binding IsVisible}">
  <Border BorderBrush="{DynamicResource ThemeControlMidBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
    <ScrollViewer MaxHeight="125" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="4">
        <Button Content="Show invalid profile fields" Command="{Binding ShowInvalidProfileFieldsCommand}"
                IsVisible="{Binding HasInvalidProfileEndpoints}" HorizontalAlignment="Left" />
        <WrapPanel>
          <TextBlock Text="Inspect profile (display only)" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding InspectionOptions}"
                    SelectedItem="{Binding InspectedProfile, Mode=TwoWay}"
                    AutomationProperties.Name="Inspect profile"
                    IsEnabled="{Binding !IsBusy}" />
        </WrapPanel>
        <ItemsControl ItemsSource="{Binding ProfileIssues}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AIProfileIssueViewModel">
              <StackPanel Spacing="2" Margin="0,0,0,4">
                <Button Content="{Binding InspectLabel}" Command="{Binding InspectCommand}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="11" Opacity="0.8" />
        <CheckBox Content="Show all provider fields" IsChecked="{Binding ShowAllProviderFields, Mode=TwoWay}" />
        <WrapPanel>
          <Button Content="Use template endpoint" Command="{Binding UseTemplateEndpointCommand}" Margin="0,0,8,0" />
          <Button Content="Use template model" Command="{Binding UseTemplateModelCommand}" Margin="0,0,8,0" />
          <Button Content="Copy global endpoint" Command="{Binding CopyLegacyEndpointCommand}" Margin="0,0,8,0" />
          <Button Content="Copy global model" Command="{Binding CopyLegacyModelCommand}" Margin="0,0,8,0" />
          <Button Content="Manage active credentials..." Click="OnManageCredentialsClick"
                  IsEnabled="{Binding CanManageActiveCredentials}" />
        </WrapPanel>
        <TextBlock Text="{Binding ActionMessage}" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
