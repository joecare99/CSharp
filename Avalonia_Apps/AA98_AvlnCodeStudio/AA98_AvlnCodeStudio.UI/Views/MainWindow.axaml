<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AA98_AvlnCodeStudio.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:diagnostics="using:AA98_AvlnCodeStudio.Diagnostics.UI.Views"
        xmlns:configUi="using:Config.UI.Avalonia.Views"
        xmlns:projectExplorer="using:Project.Explorer.Avalonia.Views"
        xmlns:debugging="using:AA98_AvlnCodeStudio.Base.Debugging.Models"
        xmlns:designer="using:AA98_AvlnCodeStudio.AxamlDesigner.UI.Views"
        xmlns:workspaces="using:AA98_AvlnCodeStudio.Model.Workspaces"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="AA98_AvlnCodeStudio.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        Title="{Binding WindowTitle}">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Margin="12"
          RowDefinitions="Auto,*,Auto"
          ColumnDefinitions="260,*">
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,8"
                Padding="8,6"
                BorderBrush="{DynamicResource ThemeControlMidBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel Spacing="8">
                <Menu>
                    <MenuItem Header="{Binding FileMenuHeader}">
                        <MenuItem Header="{Binding ProjectTemplatesMenuText}">
                            <MenuItem Header="{Binding CreateSelectedProjectCommandText}" Command="{Binding CreateSelectedProjectCommand}" />
                            <MenuItem Header="{Binding ReloadProjectTemplatesCommandText}" Command="{Binding ReloadProjectTemplatesCommand}" />
                        </MenuItem>
                        <MenuItem Header="{Binding OpenWorkspaceCommandText}" Command="{Binding OpenWorkspaceCommand}" />
                        <MenuItem Header="{Binding BuildWorkspaceCommandText}" Command="{Binding BuildWorkspaceCommand}" />
                        <MenuItem Header="{Binding RunTestsCommandText}" Command="{Binding RunWorkspaceTestsCommand}" />
                        <MenuItem Header="{Binding StartDebuggingCommandText}" Command="{Binding StartDebugSessionCommand}" />
                        <MenuItem Header="{Binding StopDebuggingCommandText}" Command="{Binding StopDebugSessionCommand}" />
                        <MenuItem Header="{Binding ToggleBreakpointCommandText}" Command="{Binding ToggleBreakpointCommand}" />
                        <MenuItem Header="{Binding ContinueDebuggingCommandText}" Command="{Binding ContinueDebugSessionCommand}" />
                        <MenuItem Header="{Binding PauseDebuggingCommandText}" Command="{Binding PauseDebugSessionCommand}" />
                        <MenuItem Header="{Binding StepIntoCommandText}" Command="{Binding StepIntoCommand}" />
                        <MenuItem Header="{Binding StepOverCommandText}" Command="{Binding StepOverCommand}" />
                        <MenuItem Header="{Binding StepOutCommandText}" Command="{Binding StepOutCommand}" />
                        <MenuItem Header="{Binding NewCommandText}" Command="{Binding NewDocumentCommand}" />
                        <MenuItem Header="{Binding OpenCommandText}" Command="{Binding OpenDocumentCommand}" />
                        <MenuItem Header="{Binding SaveCommandText}" Command="{Binding Editor.SaveCommand}" />
                        <MenuItem Header="{Binding SaveAsCommandText}" Command="{Binding Editor.SaveAsCommand}" />
                        <MenuItem Header="{Binding CompleteCommandText}" Command="{Binding RequestCompletionsCommand}" />
                        <MenuItem Header="{Binding GoToDefinitionCommandText}" Command="{Binding GoToDefinitionCommand}" />
                    </MenuItem>
                    <MenuItem Header="{Binding ViewMenuHeader}">
                        <MenuItem Header="{Binding NavigationPlaceholderMenuText}" />
                        <MenuItem Header="{Binding StatusPlaceholderMenuText}" />
                    </MenuItem>
                </Menu>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox Width="220"
                              ItemsSource="{Binding ProjectTemplates}"
                              SelectedItem="{Binding SelectedProjectTemplate, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{Binding CreateSelectedProjectCommandText}" Command="{Binding CreateSelectedProjectCommand}" />
                    <Button Content="{Binding ReloadProjectTemplatesCommandText}" Command="{Binding ReloadProjectTemplatesCommand}" />
                    <Button Content="{Binding NewCommandText}" Command="{Binding NewDocumentCommand}" />
                    <Button Content="{Binding OpenCommandText}" Command="{Binding OpenDocumentCommand}" />
                    <Button Content="{Binding SaveCommandText}" Command="{Binding Editor.SaveCommand}" />
                    <Button Content="{Binding SaveAsCommandText}" Command="{Binding Editor.SaveAsCommand}" />
                    <Button Content="{Binding BuildWorkspaceCommandText}" Command="{Binding BuildWorkspaceCommand}" />
                    <Button Content="{Binding RunTestsCommandText}" Command="{Binding RunWorkspaceTestsCommand}" />
                    <Button Content="{Binding CompleteCommandText}" Command="{Binding RequestCompletionsCommand}" />
                    <Button Content="{Binding GoToDefinitionCommandText}" Command="{Binding GoToDefinitionCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="220" PlaceholderText="{Binding DebugTargetPlaceholderText}" Text="{Binding DebugTargetPath, Mode=TwoWay}" />
                    <Button Content="{Binding StartDebuggingCommandText}" Command="{Binding StartDebugSessionCommand}" />
                    <Button Content="{Binding StopDebuggingCommandText}" Command="{Binding StopDebugSessionCommand}" />
                    <Button Content="{Binding ToggleBreakpointCommandText}" Command="{Binding ToggleBreakpointCommand}" />
                    <Button Content="{Binding ContinueDebuggingCommandText}" Command="{Binding ContinueDebugSessionCommand}" />
                    <Button Content="{Binding PauseDebuggingCommandText}" Command="{Binding PauseDebugSessionCommand}" />
                    <Button Content="{Binding StepIntoCommandText}" Command="{Binding StepIntoCommand}" />
                    <Button Content="{Binding StepOverCommandText}" Command="{Binding StepOverCommand}" />
                    <Button Content="{Binding StepOutCommandText}" Command="{Binding StepOutCommand}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,120"
                      ColumnSpacing="8"
                      RowSpacing="6">
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Width="200"
                                      PlaceholderText="{Binding PackageProjectPlaceholderText}"
                                      ItemsSource="{Binding PackageProjects}"
                                      SelectedItem="{Binding SelectedPackageProject, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="{Binding ListPackagesCommandText}" Command="{Binding RefreshPackagesCommand}" />
                            <TextBox Width="200"
                                     PlaceholderText="{Binding PackageSearchPlaceholderText}"
                                     Text="{Binding PackageSearchText, Mode=TwoWay}" />
                            <Button Content="{Binding SearchPackagesCommandText}" Command="{Binding SearchPackagesCommand}" />
                            <TextBox Width="180"
                                     PlaceholderText="{Binding PackageIdPlaceholderText}"
                                     Text="{Binding PackageId, Mode=TwoWay}" />
                            <TextBox Width="150"
                                     PlaceholderText="{Binding PackageVersionPlaceholderText}"
                                     Text="{Binding PackageVersion, Mode=TwoWay}" />
                            <Button Content="{Binding AddPackageCommandText}" Command="{Binding AddPackageCommand}" />
                            <Button Content="{Binding RemovePackageCommandText}" Command="{Binding RemovePackageCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <ListBox Grid.Row="1" Grid.Column="0"
                             ItemsSource="{Binding InstalledPackages}"
                             SelectedItem="{Binding SelectedInstalledPackage, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="workspaces:CSharpProjectPackageReference">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ResolvedVersion}" />
                                    <TextBlock Text="{Binding TargetFramework}" Opacity="0.7" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox Grid.Row="1" Grid.Column="1"
                             ItemsSource="{Binding PackageSearchResults}"
                             SelectedItem="{Binding SelectedPackageSearchResult, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="workspaces:NuGetPackageSearchResult">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding LatestVersion}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}"
                                               Opacity="0.7"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,12,0"
                Padding="12"
                BorderBrush="{DynamicResource ThemeControlMidBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid RowDefinitions="Auto,Auto,180,*,Auto"
                  RowSpacing="8">
                <TextBlock Grid.Row="0"
                           Text="{Binding NavigationTitle}"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Row="1"
                           Text="{Binding PlanningExplorerTitle}"
                           Opacity="0.7"
                           TextWrapping="Wrap" />
                <projectExplorer:ProjectExplorerView Grid.Row="2"
                                                      DataContext="{Binding ProjectExplorer}" />
                <TreeView Grid.Row="3"
                          ItemsSource="{Binding PlanningExplorer.RootItems}"
                          SelectedItem="{Binding PlanningExplorer.SelectedItem, Mode=TwoWay}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Id}" />
                                <TextBlock Text="{Binding Title}" Opacity="0.8" />
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <configUi:ConfigUiView Grid.Row="4"
                                       DataContext="{Binding ConfigUi}"
                                       Margin="0,8,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Padding="12"
                BorderBrush="{DynamicResource ThemeControlMidBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,8"
                           Text="{Binding EditorRegionTitle}"
                           FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,8"
                           Text="{Binding WorkspaceTitle}"
                           Opacity="0.7"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,8"
                           Text="{Binding VersionControlSummary}"
                           Opacity="0.7" />
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Spacing="8"
                            IsVisible="{Binding HasCompletionSuggestions}">
                    <ListBox Width="260"
                             Height="140"
                             ItemsSource="{Binding CompletionSuggestions}"
                             SelectedItem="{Binding SelectedCompletion, Mode=TwoWay}" />
                    <Button VerticalAlignment="Top"
                            Content="{Binding ApplyCompletionCommandText}"
                            Command="{Binding ApplySelectedCompletionCommand}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom"
                            Margin="0,8,0,0"
                            Spacing="4"
                            IsVisible="{Binding HasDebugSession}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{Binding RefreshDebugStackCommandText}"
                                Command="{Binding RefreshDebugStackCommand}" />
                        <Button Content="{Binding LoadDebugVariablesCommandText}"
                                Command="{Binding LoadDebugVariablesCommand}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Height="140">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding DebugStackFramesTitle}" FontWeight="SemiBold" />
                            <ListBox ItemsSource="{Binding DebugStackFrames}"
                                     SelectedItem="{Binding SelectedDebugStackFrame, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="debugging:DebugStackFrame">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding SourcePath}" Opacity="0.7" />
                                            <TextBlock Text="{Binding Line}" Opacity="0.7" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding DebugVariablesTitle}" FontWeight="SemiBold" />
                            <ListBox ItemsSource="{Binding DebugVariables}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="debugging:DebugVariable">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Value}" />
                                            <TextBlock Text="{Binding Type}" Opacity="0.7" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto,*">
                    <TabControl Grid.Column="0"
                                ItemsSource="{Binding EditorWorkspace.Tabs}"
                                SelectedItem="{Binding ActiveEditorTab, Mode=TwoWay}">
                        <TabControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EditorTabViewModel">
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:EditorTabViewModel">
                                <ContentControl Content="{Binding View}" />
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                    <GridSplitter Grid.Column="1"
                                  Width="8"
                                  ResizeDirection="Columns"
                                  IsVisible="{Binding HasAxamlPreview}" />
                    <designer:AxamlDesignerView Grid.Column="2"
                                                Margin="8,0,0,0"
                                                IsVisible="{Binding HasPreview}"
                                                DataContext="{Binding AxamlDesigner}" />
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="0,12,0,0"
                RowDefinitions="Auto,Auto"
                RowSpacing="8">
        <Border Grid.Row="0"
                Padding="8,6"
                BorderBrush="{DynamicResource ThemeControlMidBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel Spacing="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Margin="0,0,16,0"
                               Text="{Binding StatusRegionTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Editor.StatusText}" />
                </DockPanel>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Margin="0,0,16,0"
                               Text="{Binding NotificationRegionTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Editor.NotificationText}" />
                </DockPanel>
            </StackPanel>
        </Border>
        <diagnostics:DiagnosticListView Grid.Row="1"
                                         DataContext="{Binding DiagnosticCollection}" />
        </Grid>
    </Grid>

</Window>
    