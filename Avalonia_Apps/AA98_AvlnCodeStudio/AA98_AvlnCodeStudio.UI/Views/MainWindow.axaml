<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AA98_AvlnCodeStudio.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:diagnostics="using:AA98_AvlnCodeStudio.Diagnostics.UI.Views"
        xmlns:projectExplorer="using:Project.Explorer.Avalonia.Views"
        xmlns:debugging="using:AA98_AvlnCodeStudio.Base.Debugging.Models"
        xmlns:propertyEditor="using:Property.Editor.Avalonia.Views"
        xmlns:workspaces="using:AA98_AvlnCodeStudio.Model.Workspaces"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="AA98_AvlnCodeStudio.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        Background="#252526"
        Title="{Binding WindowTitle}">

    <Window.Styles>
        <Style Selector="TabControl TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Menu">
            <Setter Property="Background" Value="#1E1E1E" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ClipToBounds="True"
          RowDefinitions="*,28">
        <Grid Grid.Row="0"
              Margin="8"
              MinHeight="0"
              RowDefinitions="Auto,*,Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding WorkspacePaneWidth, Mode=TwoWay}" />
                <ColumnDefinition Width="{Binding WorkspacePaneSplitterWidth}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
        <Border Grid.Row="0"
                Grid.ColumnSpan="5"
                Margin="0,0,0,8"
                Padding="8,4"
                BorderBrush="{DynamicResource ThemeControlMidBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel Spacing="6">
                <Menu>
                    <MenuItem Header="{Binding FileMenuHeader}">
                        <MenuItem Header="{Binding NewCommandText}" Command="{Binding NewDocumentCommand}" />
                        <MenuItem Header="{Binding OpenCommandText}" Command="{Binding OpenDocumentCommand}" />
                        <MenuItem Header="{Binding SaveCommandText}" Command="{Binding ActiveEditorTab.SaveCommand}" IsEnabled="{Binding CanEditActiveDocument}" />
                        <MenuItem Header="{Binding SaveAsCommandText}" Command="{Binding ActiveEditorTab.SaveAsCommand}" IsEnabled="{Binding CanEditActiveDocument}" />
                        <Separator />
                        <MenuItem Header="{Binding OpenWorkspaceCommandText}" Command="{Binding OpenWorkspaceCommand}" />
                        <MenuItem Header="{Binding ProjectTemplatesMenuText}">
                            <MenuItem Header="{Binding CreateSelectedProjectCommandText}" Command="{Binding CreateSelectedProjectCommand}" />
                            <MenuItem Header="{Binding ReloadProjectTemplatesCommandText}" Command="{Binding ReloadProjectTemplatesCommand}" />
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="{Binding WorkspaceSidebarMenuText}"
                                  ToggleType="CheckBox"
                                  IsChecked="{Binding IsWorkspacePaneVisible, Mode=TwoWay}" />
                        <Separator />
                        <MenuItem Header="Settings..." Command="{Binding OpenConfigurationCommand}" />
                        <MenuItem Header="System Settings..." Command="{Binding OpenSystemConfigurationCommand}" />
                        <MenuItem Header="Group Settings..." Command="{Binding OpenGroupConfigurationCommand}" />
                        <MenuItem Header="AI Credentials..." Command="{Binding OpenAICredentialsCommand}" />
                        <MenuItem Header="Project Settings..." Command="{Binding OpenProjectConfigurationCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="{Binding UndoWorkspaceChangeCommandText}" Command="{Binding UndoWorkspaceChangeCommand}" />
                        <MenuItem Header="{Binding RedoWorkspaceChangeCommandText}" Command="{Binding RedoWorkspaceChangeCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding CompleteCommandText}" Command="{Binding RequestCompletionsCommand}" />
                        <MenuItem Header="{Binding GoToDefinitionCommandText}" Command="{Binding GoToDefinitionCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding GenerateAxamlMvvmCommandText}" Command="{Binding GenerateAxamlMvvmCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Build">
                        <MenuItem Header="{Binding BuildWorkspaceCommandText}" Command="{Binding BuildWorkspaceCommand}" />
                        <MenuItem Header="{Binding RunTestsCommandText}" Command="{Binding RunWorkspaceTestsCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding InspectProjectCommandText}" Command="{Binding InspectSelectedProjectCommand}" />
                        <MenuItem Header="{Binding BuildSelectedProjectCommandText}" Command="{Binding BuildSelectedProjectCommand}" />
                        <MenuItem Header="{Binding TestSelectedProjectCommandText}" Command="{Binding TestSelectedProjectCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Debug">
                        <MenuItem Header="{Binding StartDebuggingCommandText}" Command="{Binding StartDebugSessionCommand}" />
                        <MenuItem Header="{Binding DebugSelectedProjectCommandText}" Command="{Binding DebugSelectedProjectCommand}" />
                        <MenuItem Header="{Binding StopDebuggingCommandText}" Command="{Binding StopDebugSessionCommand}" />
                        <MenuItem Header="{Binding ToggleBreakpointCommandText}" Command="{Binding ToggleBreakpointCommand}" />
                        <MenuItem Header="{Binding ContinueDebuggingCommandText}" Command="{Binding ContinueDebugSessionCommand}" />
                        <MenuItem Header="{Binding PauseDebuggingCommandText}" Command="{Binding PauseDebugSessionCommand}" />
                        <MenuItem Header="{Binding StepIntoCommandText}" Command="{Binding StepIntoCommand}" />
                        <MenuItem Header="{Binding StepOverCommandText}" Command="{Binding StepOverCommand}" />
                        <MenuItem Header="{Binding StepOutCommandText}" Command="{Binding StepOutCommand}" />
                    </MenuItem>
                </Menu>

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Command="{Binding OpenWorkspaceCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Source="/Assets/Icons/workspace-open.png" Width="16" Height="16" />
                            <TextBlock Text="{Binding OpenWorkspaceCommandText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NewDocumentCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Source="/Assets/Icons/document-new.png" Width="16" Height="16" />
                            <TextBlock Text="{Binding NewCommandText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenDocumentCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Source="/Assets/Icons/document-open.png" Width="16" Height="16" />
                            <TextBlock Text="{Binding OpenCommandText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ActiveEditorTab.SaveCommand}" IsEnabled="{Binding CanEditActiveDocument}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Source="/Assets/Icons/save.png" Width="16" Height="16" />
                            <TextBlock Text="{Binding SaveCommandText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding BuildWorkspaceCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Source="/Assets/Icons/build.png" Width="16" Height="16" />
                            <TextBlock Text="{Binding BuildWorkspaceCommandText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RunWorkspaceTestsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Source="/Assets/Icons/test.png" Width="16" Height="16" />
                            <TextBlock Text="{Binding RunTestsCommandText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,8,0"
                Padding="6"
                MinHeight="0"
                IsVisible="{Binding IsWorkspacePaneVisible}"
                BorderBrush="{DynamicResource ThemeControlMidBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <TabControl>
                <TabItem Header="Solution">
                    <Grid RowDefinitions="Auto,*" RowSpacing="6">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding WorkspaceTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding VersionControlSummary}" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <projectExplorer:ProjectExplorerView Grid.Row="1" DataContext="{Binding ProjectExplorer}" />
                    </Grid>
                </TabItem>
                <TabItem Header="{Binding ProjectWorkflowTabText}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding ProjectWorkflowProjectText}" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding PackageProjects}"
                                      SelectedItem="{Binding SelectedWorkflowProject, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding ProjectWorkflowProjectText}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="workspaces:CSharpWorkspaceProject">
                                        <TextBlock Text="{Binding ProjectPath}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding ProjectWorkflowConfigurationText}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding WorkflowConfiguration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{Binding ProjectWorkflowConfigurationText}" />
                            <TextBlock Text="{Binding ProjectWorkflowFrameworkText}" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding WorkflowFrameworks}"
                                      SelectedItem="{Binding SelectedWorkflowFramework, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding ProjectWorkflowFrameworkText}" />
                            <TextBlock Text="{Binding ProjectWorkflowTrustWarningText}" TextWrapping="Wrap" Opacity="0.8" />
                            <Button Content="{Binding InspectProjectCommandText}" Command="{Binding InspectSelectedProjectCommand}" />
                            <Button Content="{Binding BuildSelectedProjectCommandText}" Command="{Binding BuildSelectedProjectCommand}" />
                            <Button Content="{Binding TestSelectedProjectCommandText}" Command="{Binding TestSelectedProjectCommand}" />
                            <Button Content="{Binding DebugSelectedProjectCommandText}" Command="{Binding DebugSelectedProjectCommand}" />
                            <Button Content="{Binding CancelProjectWorkflowCommandText}" Command="{Binding CancelProjectWorkflowCommand}" />
                            <TextBlock Text="{Binding ProjectWorkflowStatus}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Palette">
                    <Grid>
                        <TextBlock Text="The active editor does not provide a palette."
                                   IsVisible="{Binding !ActiveEditorTab.HasPalette}"
                                   TextWrapping="Wrap" Margin="8" />
                        <ContentControl IsVisible="{Binding ActiveEditorTab.HasPalette}"
                                        Content="{Binding ActiveEditorTab.PaletteView}" />
                    </Grid>
                </TabItem>
                <TabItem Header="AI Chat">
                    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
                        <StackPanel Spacing="6">
                            <ComboBox ItemsSource="{Binding AIChatAgentModes}"
                                      SelectedItem="{Binding SelectedAIChatAgent, Mode=TwoWay}"
                                      IsEnabled="{Binding !AiChatBusy}"
                                      PlaceholderText="Select agent" />
                            <TextBox Text="{Binding SessionAIModel, Mode=TwoWay}"
                                     IsEnabled="{Binding !AiChatBusy}"
                                     PlaceholderText="Model override (session only)"
                                     AutomationProperties.Name="Session model override" />
                            <TextBlock Text="{Binding AIChatModelHint}"
                                       Opacity="0.8"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AIChatStatus}"
                                       Opacity="0.8"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding AIChatMessages}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:AIChatMessageViewModel">
                                    <StackPanel Margin="4" Spacing="2">
                                        <TextBlock Text="{Binding Role}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBox Grid.Row="2"
                                 MinHeight="72"
                                 PlaceholderText="{Binding AIChatInputPlaceholderText}"
                                 Text="{Binding AiChatInput, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap" />
                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button Content="Clear"
                                    Command="{Binding ClearAIChatCommand}" />
                            <Button Content="Cancel"
                                    Command="{Binding SendAIChatMessageCancelCommand}" />
                            <Button Content="{Binding AIChatSendCommandText}"
                                    Command="{Binding SendAIChatMessageCommand}" />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Plan">
                    <TreeView ItemsSource="{Binding PlanningExplorer.RootItems}"
                              SelectedItem="{Binding PlanningExplorer.SelectedItem, Mode=TwoWay}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Id}" />
                                    <TextBlock Text="{Binding Title}" Opacity="0.8" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </TabItem>
                <TabItem Header="NuGet">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Project" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding PackageProjects}"
                                      SelectedItem="{Binding SelectedPackageProject, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="{Binding ListPackagesCommandText}"
                                    Command="{Binding RefreshPackagesCommand}" />
                        </StackPanel>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <TextBox PlaceholderText="{Binding PackageSearchPlaceholderText}"
                                     Text="{Binding PackageSearchText, Mode=TwoWay}" />
                            <Button Grid.Column="1"
                                    Content="{Binding SearchPackagesCommandText}"
                                    Command="{Binding SearchPackagesCommand}" />
                        </Grid>
                        <TabControl Grid.Row="2">
                            <TabItem Header="Installed">
                                <ListBox ItemsSource="{Binding InstalledPackages}"
                                         SelectedItem="{Binding SelectedInstalledPackage, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="workspaces:CSharpProjectPackageReference">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ResolvedVersion}" Opacity="0.8" />
                                                <TextBlock Text="{Binding TargetFramework}" Opacity="0.7" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                            <TabItem Header="Search results">
                                <ListBox ItemsSource="{Binding PackageSearchResults}"
                                         SelectedItem="{Binding SelectedPackageSearchResult, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="workspaces:NuGetPackageSearchResult">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding LatestVersion}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           Opacity="0.7"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                        </TabControl>
                        <StackPanel Grid.Row="3" Spacing="6">
                            <TextBox PlaceholderText="{Binding PackageIdPlaceholderText}"
                                     Text="{Binding PackageId, Mode=TwoWay}" />
                            <TextBox PlaceholderText="{Binding PackageVersionPlaceholderText}"
                                     Text="{Binding PackageVersion, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="{Binding AddPackageCommandText}" Command="{Binding AddPackageCommand}" />
                                <Button Content="{Binding RemovePackageCommandText}" Command="{Binding RemovePackageCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Debug">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <TextBox PlaceholderText="{Binding DebugTargetPlaceholderText}"
                                     Text="{Binding DebugTargetPath, Mode=TwoWay}" />
                            <Button Content="{Binding StartDebuggingCommandText}"
                                    Command="{Binding StartDebugSessionCommand}" />
                            <Button Content="{Binding StopDebuggingCommandText}"
                                    Command="{Binding StopDebugSessionCommand}" />
                            <Button Content="{Binding ToggleBreakpointCommandText}"
                                    Command="{Binding ToggleBreakpointCommand}" />
                            <Button Content="{Binding ContinueDebuggingCommandText}"
                                    Command="{Binding ContinueDebugSessionCommand}" />
                            <Button Content="{Binding PauseDebuggingCommandText}"
                                    Command="{Binding PauseDebugSessionCommand}" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="{Binding StepIntoCommandText}" Command="{Binding StepIntoCommand}" />
                                <Button Content="{Binding StepOverCommandText}" Command="{Binding StepOverCommand}" />
                                <Button Content="{Binding StepOutCommandText}" Command="{Binding StepOutCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="8" ResizeDirection="Columns"
                      IsVisible="{Binding IsWorkspacePaneVisible}" />
        <Border Grid.Row="1"
                Grid.Column="2"
                Padding="8"
                MinHeight="0"
                BorderBrush="{DynamicResource ThemeControlMidBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top"
                            Margin="0,0,0,8"
                            Spacing="4">
                    <TextBlock Text="{Binding EditorRegionTitle}"
                               FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding WorkspaceTitle}"
                                   Opacity="0.75"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding VersionControlSummary}"
                                   Opacity="0.75"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2"
                                Content="{Binding UpdateSvnWorkspaceCommandText}"
                                Command="{Binding UpdateSvnWorkspaceCommand}"
                                IsVisible="{Binding CanUpdateSvnWorkspace}" />
                    </Grid>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top"
                            Margin="0,0,0,8"
                            Orientation="Horizontal"
                            Spacing="8"
                            IsVisible="{Binding HasCompletionSuggestions}">
                    <ListBox Width="260"
                             Height="140"
                             ItemsSource="{Binding CompletionSuggestions}"
                             SelectedItem="{Binding SelectedCompletion, Mode=TwoWay}" />
                    <Button VerticalAlignment="Top"
                            Content="{Binding ApplyCompletionCommandText}"
                            Command="{Binding ApplySelectedCompletionCommand}" />
                </StackPanel>
                <Expander DockPanel.Dock="Bottom"
                          Margin="0,8,0,0"
                          Header="Debug details"
                          IsVisible="{Binding HasDebugSession}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Height="140">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding DebugStackFramesTitle}" FontWeight="SemiBold" />
                            <Button HorizontalAlignment="Left"
                                    Content="{Binding RefreshDebugStackCommandText}"
                                    Command="{Binding RefreshDebugStackCommand}" />
                            <ListBox ItemsSource="{Binding DebugStackFrames}"
                                     SelectedItem="{Binding SelectedDebugStackFrame, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="debugging:DebugStackFrame">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding SourcePath}"
                                                       Opacity="0.7"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Line}" Opacity="0.7" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding DebugVariablesTitle}" FontWeight="SemiBold" />
                            <Button HorizontalAlignment="Left"
                                    Content="{Binding LoadDebugVariablesCommandText}"
                                    Command="{Binding LoadDebugVariablesCommand}" />
                            <ListBox ItemsSource="{Binding DebugVariables}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="debugging:DebugVariable">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Value}" />
                                            <TextBlock Text="{Binding Type}" Opacity="0.7" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </Expander>
                <TabControl ItemsSource="{Binding EditorWorkspace.Tabs}"
                            SelectedItem="{Binding ActiveEditorTab, Mode=TwoWay}">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EditorTabViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="4" PointerPressed="OnEditorTabHeaderPointerPressed">
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                <Button Content="x" Padding="4,0" Click="OnCloseEditorTabRequested"
                                        AutomationProperties.Name="Close editor tab" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:EditorTabViewModel">
                            <ContentControl Content="{Binding View}" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="3" Width="8" ResizeDirection="Columns" />
        <Border Grid.Row="1" Grid.Column="4" Padding="6" MinHeight="0"
                BorderBrush="{DynamicResource ThemeControlMidBrush}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding PropertySelectionCaption}"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                <Grid>
                    <Grid IsVisible="{Binding !HasEditorPropertyView}" RowDefinitions="*,Auto,Auto">
                        <ScrollViewer>
                            <propertyEditor:PropertyEditorPanel DataContext="{Binding SelectionProperties}" />
                        </ScrollViewer>
                        <TextBlock Grid.Row="1" Text="{Binding PropertySelectionError}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding HasStandardEditorPropertySelection}">
                            <Button Content="Apply" Command="{Binding ApplyEditorPropertiesCommand}"
                                    IsEnabled="{Binding CanEditSelectedProperties}" />
                            <Button Content="Discard" Command="{Binding DiscardEditorPropertiesCommand}"
                                    IsEnabled="{Binding CanEditSelectedProperties}" />
                        </StackPanel>
                    </Grid>
                    <ContentControl IsVisible="{Binding HasEditorPropertyView}"
                                    Content="{Binding SelectedEditorPropertyView}" />
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2"
              Grid.ColumnSpan="5"
              Margin="0,8,0,0"
              MaxHeight="220">
            <Expander
                      Header="Diagnostics"
                      MaxHeight="220">
                <diagnostics:DiagnosticListView DataContext="{Binding DiagnosticCollection}" />
            </Expander>
        </Grid>
        </Grid>

        <Border Grid.Row="1"
                Height="28"
                Padding="8,3"
                Background="#2D2D30"
                BorderBrush="#555555"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding DocumentStatusLabel}"
                               Opacity="0.75"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Editor.StatusText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6">
                    <TextBlock Text="{Binding EditorStatusLabel}"
                               Opacity="0.75"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Editor.NotificationText}"
                               Opacity="0.8"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding VersionControlSummary}"
                           Opacity="0.8"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
