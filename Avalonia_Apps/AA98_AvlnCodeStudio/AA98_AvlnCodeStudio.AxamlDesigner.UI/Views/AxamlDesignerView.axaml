<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:AA98_AvlnCodeStudio.AxamlDesigner.UI.Views"
             xmlns:vm="using:AA98_AvlnCodeStudio.AxamlDesigner.UI.ViewModels"
             x:Class="AA98_AvlnCodeStudio.AxamlDesigner.UI.Views.AxamlDesignerView"
             x:DataType="vm:AxamlDesignerViewModel">
  <Grid ColumnDefinitions="*,8,240,8,2*" ColumnSpacing="8">
    <views:AxamlDesignerSurfaceView x:Name="SurfaceView" Grid.Column="0" />
    <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns" />
    <views:AxamlDesignerPaletteView Grid.Column="2" />
    <GridSplitter Grid.Column="3" Width="8" ResizeDirection="Columns" />
    <views:AxamlDesignerPropertiesView Grid.Column="4" />
  </Grid>
</UserControl>
