<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AA98_AvlnCodeStudio.AxamlDesigner.UI.ViewModels"
             xmlns:preview="using:AA98_AvlnCodeStudio.AxamlDesigner.UI.Controls"
             xmlns:propertyEditor="using:Property.Editor.Avalonia.Views"
             x:Class="AA98_AvlnCodeStudio.AxamlDesigner.UI.Views.AxamlDesignerView"
             x:DataType="vm:AxamlDesignerViewModel">
  <Grid ColumnDefinitions="*,8,240,8,2*"
        ColumnSpacing="8">
    <Border Grid.Column="0"
            Padding="8"
            BorderBrush="{DynamicResource ThemeControlMidBrush}"
            BorderThickness="1"
            CornerRadius="4">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,6"
                   Text="{Binding PreviewTitle}"
                   TextWrapping="Wrap"
                   FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,6"
                   Text="Drag the selected element's blue corner to resize."
                   TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,6"
                   Text="{Binding ErrorText}"
                   TextWrapping="Wrap" />
        <ScrollViewer>
          <preview:AxamlPreviewControl x:Name="PreviewControl"
                                       PreviewNode="{Binding PreviewRoot}"
                                       SelectedNode="{Binding SelectedNode, Mode=TwoWay}" />
        </ScrollViewer>
      </DockPanel>
    </Border>
    <GridSplitter Grid.Column="1"
                  Width="8"
                  ResizeDirection="Columns" />
    <Border Grid.Column="2"
            Padding="8"
            BorderBrush="{DynamicResource ThemeControlMidBrush}"
            BorderThickness="1"
            CornerRadius="4">
      <Grid RowDefinitions="Auto,*"
            RowSpacing="8">
        <UniformGrid Grid.Row="0" Columns="2">
          <Button Content="Undo" Command="{Binding UndoCommand}" />
          <Button Content="Redo" Command="{Binding RedoCommand}" />
          <Button Content="Screenshot" Click="OnScreenshotRequested" />
        </UniformGrid>
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="6">
            <Expander Header="Basis controls" IsExpanded="True">
              <UniformGrid Columns="2" Margin="4">
                <Button Content="TextBlock" Command="{Binding AddTextBlockCommand}" />
                <Button Content="Label" Command="{Binding AddLabelCommand}" />
                <Button Content="Button" Command="{Binding AddButtonCommand}" />
                <Button Content="Progress" Command="{Binding AddProgressBarCommand}" />
                <Button Content="Separator" Command="{Binding AddSeparatorCommand}" />
              </UniformGrid>
            </Expander>
            <Expander Header="Eingabe" IsExpanded="False">
              <UniformGrid Columns="2" Margin="4">
                <Button Content="TextBox" Command="{Binding AddTextBoxCommand}" />
                <Button Content="CheckBox" Command="{Binding AddCheckBoxCommand}" />
                <Button Content="ComboBox" Command="{Binding AddComboBoxCommand}" />
                <Button Content="Numeric" Command="{Binding AddNumericUpDownCommand}" />
                <Button Content="RadioButton" Command="{Binding AddRadioButtonCommand}" />
                <Button Content="Slider" Command="{Binding AddSliderCommand}" />
                <Button Content="Toggle" Command="{Binding AddToggleSwitchCommand}" />
              </UniformGrid>
            </Expander>
            <Expander Header="Layout und Container" IsExpanded="False">
              <StackPanel Spacing="6" Margin="4">
                <TextBlock Text="Add layout container" FontWeight="SemiBold" />
                <UniformGrid Columns="2">
                  <Button Content="Border" Command="{Binding AddBorderCommand}" />
                  <Button Content="Content" Command="{Binding AddContentControlCommand}" />
                  <Button Content="DockPanel" Command="{Binding AddDockPanelCommand}" />
                  <Button Content="Expander" Command="{Binding AddExpanderCommand}" />
                  <Button Content="GroupBox" Command="{Binding AddGroupBoxCommand}" />
                  <Button Content="Grid" Command="{Binding AddGridCommand}" />
                  <Button Content="ScrollViewer" Command="{Binding AddScrollViewerCommand}" />
                  <Button Content="StackPanel" Command="{Binding AddStackPanelCommand}" />
                  <Button Content="UniformGrid" Command="{Binding AddUniformGridCommand}" />
                  <Button Content="Viewbox" Command="{Binding AddViewboxCommand}" />
                  <Button Content="WrapPanel" Command="{Binding AddWrapPanelCommand}" />
                </UniformGrid>
              </StackPanel>
            </Expander>
            <TextBlock Text="Correct invalid markup first, then add controls. DockPanel keeps its client last; Grid uses the next free cell."
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <ComboBox ItemsSource="{Binding DockPanelPlacements}"
                      SelectedItem="{Binding SelectedDockPanelPlacement, Mode=TwoWay}"
                      IsVisible="{Binding IsDockPanelSelected}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
    <GridSplitter Grid.Column="3"
                  Width="8"
                  ResizeDirection="Columns" />
    <Border Grid.Column="4"
            Padding="8"
            BorderBrush="{DynamicResource ThemeControlMidBrush}"
            BorderThickness="1"
            CornerRadius="4">
      <Grid RowDefinitions="Auto,Auto,*,Auto"
            RowSpacing="8">
        <TextBlock Grid.Row="0"
                   Text="{Binding SelectedElementName}"
                   TextWrapping="Wrap"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Text="{Binding SelectedCapabilityText}"
                   TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <propertyEditor:PropertyEditorPanel DataContext="{Binding PropertyEditor}" />
            <ItemsControl ItemsSource="{Binding PropertyRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AxamlPropertyRowViewModel">
                  <StackPanel Orientation="Horizontal"
                              Spacing="8"
                              IsVisible="{Binding HasValidationError}">
                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ValidationError}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Content="Discard"
                            IsVisible="{Binding IsDraft}"
                            Click="OnDiscardPropertyDraft" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Spacing="4"
                        IsVisible="{Binding HasBindingRows}">
              <TextBlock Text="ViewModel bindings"
                         FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding BindingRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AxamlBindingRowViewModel">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding PropertyName}"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="{Binding MemberKindLabel}"
                                 FontSize="11" />
                      <TextBlock Text="{Binding BindingExpressionDiagnostic}"
                                 IsVisible="{Binding HasUnsupportedBindingExpression}"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="Binding mode"
                                 IsVisible="{Binding SupportsBindingMode}"
                                 FontSize="11" />
                      <ComboBox ItemsSource="{Binding BindingModes}"
                                SelectedItem="{Binding BindingMode, Mode=TwoWay}"
                                IsVisible="{Binding SupportsBindingMode}"
                                IsEnabled="{Binding CanEditBinding}" />
                      <TextBlock Text="Update source trigger"
                                 IsVisible="{Binding SupportsUpdateSourceTrigger}"
                                 FontSize="11" />
                      <ComboBox ItemsSource="{Binding UpdateSourceTriggers}"
                                SelectedItem="{Binding UpdateSourceTrigger, Mode=TwoWay}"
                                IsVisible="{Binding SupportsUpdateSourceTrigger}"
                                IsEnabled="{Binding CanEditBinding}" />
                      <TextBlock Text="ViewModel member"
                                 FontSize="11" />
                      <ComboBox ItemsSource="{Binding MemberSources}"
                                SelectedItem="{Binding MemberSource, Mode=TwoWay}"
                                IsEnabled="{Binding CanEditBinding}" />
                      <TextBlock Text="Existing member"
                                 IsVisible="{Binding IsSelectingExistingMember}"
                                 FontSize="11" />
                      <ComboBox ItemsSource="{Binding AvailableMembers}"
                                SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                                IsVisible="{Binding IsSelectingExistingMember}"
                                IsEnabled="{Binding CanEditBinding}" />
                      <TextBlock Text="New member name"
                                 IsVisible="{Binding IsCreatingNewMember}"
                                 FontSize="11" />
                      <TextBox Text="{Binding NewMemberName, Mode=TwoWay}"
                               PlaceholderText="{Binding NewMemberPlaceholder}"
                               IsVisible="{Binding IsCreatingNewMember}"
                               IsEnabled="{Binding CanEditBinding}" />
                      <Button HorizontalAlignment="Left"
                              Content="Apply binding"
                              IsEnabled="{Binding CanEditBinding}"
                              Click="OnApplyBinding" />
                      <TextBlock Text="{Binding Diagnostic}"
                                 IsVisible="{Binding HasDiagnostic}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Choose an existing ViewModel member or create one. In the Workbench and standalone host, missing members and AXAML bindings are reviewed together. The Workbench includes unsaved editor content; the standalone host requires an explicitly selected solution or project and a saved view inside its workspace. Both require CommunityToolkit.Mvvm in the owning project."
                         TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusText}"
                   TextWrapping="Wrap" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
