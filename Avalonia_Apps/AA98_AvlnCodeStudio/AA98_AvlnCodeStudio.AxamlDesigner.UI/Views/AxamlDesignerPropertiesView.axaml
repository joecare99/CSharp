<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AA98_AvlnCodeStudio.AxamlDesigner.UI.ViewModels"
             xmlns:propertyEditor="using:Property.Editor.Avalonia.Views"
             x:Class="AA98_AvlnCodeStudio.AxamlDesigner.UI.Views.AxamlDesignerPropertiesView"
             x:DataType="vm:AxamlDesignerViewModel">
  <Border Padding="8" BorderBrush="{DynamicResource ThemeControlMidBrush}"
          BorderThickness="1" CornerRadius="4">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
      <TextBlock Grid.Row="0" Text="{Binding SelectedElementName}"
                 TextWrapping="Wrap" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1" Text="{Binding SelectedCapabilityText}" TextWrapping="Wrap" />
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
          <propertyEditor:PropertyEditorPanel DataContext="{Binding PropertyEditor}" />
          <ItemsControl ItemsSource="{Binding PropertyRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AxamlPropertyRowViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsDraft}">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ValidationError}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Content="Apply" IsEnabled="{Binding !HasValidationError}" Click="OnApplyPropertyDraft" />
                  <Button Content="Discard" Click="OnDiscardPropertyDraft" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding UnappliedDrafts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AxamlPropertyDraft">
                <StackPanel Spacing="4" Margin="0,4">
                  <TextBlock Text="{Binding Target}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PropertyName}" />
                  <TextBox Text="{Binding Value}" IsReadOnly="True" />
                  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Restore draft" IsEnabled="{Binding CanRestore}" Click="OnRestoreStoredDraft" />
                    <Button Content="Discard draft" Click="OnDiscardStoredDraft" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Spacing="4" IsVisible="{Binding HasBindingRows}">
            <TextBlock Text="ViewModel bindings" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding BindingRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AxamlBindingRowViewModel">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding PropertyName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding MemberKindLabel}" FontSize="11" />
                    <TextBlock Text="{Binding BindingExpressionDiagnostic}"
                               IsVisible="{Binding HasUnsupportedBindingExpression}" TextWrapping="Wrap" />
                    <TextBlock Text="Binding mode" IsVisible="{Binding SupportsBindingMode}" FontSize="11" />
                    <ComboBox ItemsSource="{Binding BindingModes}" SelectedItem="{Binding BindingMode, Mode=TwoWay}"
                              IsVisible="{Binding SupportsBindingMode}" IsEnabled="{Binding CanEditBinding}" />
                    <TextBlock Text="Update source trigger" IsVisible="{Binding SupportsUpdateSourceTrigger}" FontSize="11" />
                    <ComboBox ItemsSource="{Binding UpdateSourceTriggers}"
                              SelectedItem="{Binding UpdateSourceTrigger, Mode=TwoWay}"
                              IsVisible="{Binding SupportsUpdateSourceTrigger}" IsEnabled="{Binding CanEditBinding}" />
                    <TextBlock Text="ViewModel member" FontSize="11" />
                    <ComboBox ItemsSource="{Binding MemberSources}" SelectedItem="{Binding MemberSource, Mode=TwoWay}"
                              IsEnabled="{Binding CanEditBinding}" />
                    <TextBlock Text="Existing member" IsVisible="{Binding IsSelectingExistingMember}" FontSize="11" />
                    <ComboBox ItemsSource="{Binding AvailableMembers}" SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                              IsVisible="{Binding IsSelectingExistingMember}" IsEnabled="{Binding CanEditBinding}" />
                    <TextBlock Text="New member name" IsVisible="{Binding IsCreatingNewMember}" FontSize="11" />
                    <TextBox Text="{Binding NewMemberName, Mode=TwoWay}" PlaceholderText="{Binding NewMemberPlaceholder}"
                             IsVisible="{Binding IsCreatingNewMember}" IsEnabled="{Binding CanEditBinding}" />
                    <Button HorizontalAlignment="Left" Content="Apply binding"
                            IsEnabled="{Binding CanEditBinding}" Click="OnApplyBinding" />
                    <TextBlock Text="{Binding Diagnostic}" IsVisible="{Binding HasDiagnostic}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Choose an existing ViewModel member or create one. In the Workbench and standalone host, missing members and AXAML bindings are reviewed together. The Workbench includes unsaved editor content; the standalone host requires an explicitly selected solution or project and a saved view inside its workspace. Both require CommunityToolkit.Mvvm in the owning project."
                       TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Grid.Row="3" Text="{Binding StatusText}" TextWrapping="Wrap" />
    </Grid>
  </Border>
</UserControl>
