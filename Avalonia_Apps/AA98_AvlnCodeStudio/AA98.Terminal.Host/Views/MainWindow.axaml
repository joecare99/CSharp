<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AA98.Terminal.Host.ViewModels"
        xmlns:view="using:AA98.Terminal.Host.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="720"
        x:Class="AA98.Terminal.Host.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AA98 Command Runner">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </Window.Styles>

  <Grid ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="0" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>
  <DockPanel Grid.Row="0"
             MinHeight="0"
             LastChildFill="True">
    <Grid DockPanel.Dock="Bottom"
          Margin="12,8"
          ColumnDefinitions="*,Auto,Auto,Auto"
          ColumnSpacing="6">
      <TextBox Grid.Column="0"
               PlaceholderText="Command line"
               Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <Button Grid.Column="1"
              Content="Run line"
              Command="{Binding SendInputCommand}" />
      <Button Grid.Column="2"
              Content="Start"
              Command="{Binding StartCommand}" />
      <Button Grid.Column="3"
              Content="Stop"
              Command="{Binding StopCommand}" />
    </Grid>

    <TextBlock DockPanel.Dock="Top"
               Margin="12,12,12,8"
               Text="AA98 Command Runner"
               FontSize="16"
               FontWeight="SemiBold" />

    <Border DockPanel.Dock="Top"
            Margin="12,0,12,8"
            Padding="8,6"
            Background="#332B19">
      <TextBlock Text="Line-oriented mode, no PTY: press Enter in the console or choose Run line to submit a complete command line. Interactive prompts, job control, terminal modes, and full-screen programs are not supported."
                 TextWrapping="Wrap" />
    </Border>

    <Border Margin="12,0,12,0"
            Background="Black"
            BorderBrush="Gray"
            BorderThickness="1"
            Padding="4">
      <view:TerminalConsoleView MinHeight="0" />
    </Border>
  </DockPanel>
  <Border Grid.Row="1"
          Height="28"
          Padding="8,3"
          Background="#2D2D30"
          BorderBrush="#555555"
          BorderThickness="0,1,0,0">
    <TextBlock Text="{Binding SessionDescription}"
               VerticalAlignment="Center"
               TextTrimming="CharacterEllipsis" />
  </Border>
  </Grid>
</Window>
