<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AA98.DevOpsPlanning.Host.ViewModels"
        xmlns:diagnostics="using:AA98_AvlnCodeStudio.Diagnostics.UI.Views"
        xmlns:planning="using:AA98_AvlnCodeStudio.Planning.UI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="800"
        x:Class="AA98.DevOpsPlanning.Host.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AA98 DevOps Planning Host"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </Window.Styles>

  <Grid ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="0" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>
  <DockPanel Grid.Row="0"
             MinHeight="0"
             LastChildFill="True">
    <Expander DockPanel.Dock="Bottom"
              Margin="12,4"
              Header="Diagnostics">
      <diagnostics:DiagnosticListView MaxHeight="180"
                                      DataContext="{Binding DiagnosticCollection}" />
    </Expander>

    <Menu DockPanel.Dock="Top"
          Margin="12,8">
      <MenuItem Header="_File">
        <MenuItem Header="Open Solution Root..."
                  Command="{Binding OpenSolutionRootCommand}" />
        <MenuItem Header="Open DevOps Project..."
                  Command="{Binding OpenPlanningProjectCommand}" />
        <MenuItem Header="New DevOps Project..."
                  Command="{Binding NewPlanningProjectCommand}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top"
            Margin="12,0,12,8"
            Padding="8"
            BorderBrush="{DynamicResource ThemeControlMidBrush}"
            BorderThickness="1"
            CornerRadius="4">
      <Grid RowDefinitions="Auto,Auto"
            ColumnDefinitions="Auto,*,Auto,Auto"
            RowSpacing="8"
            ColumnSpacing="8">
        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="4"
                   Text="AA98 DevOps Planning Host"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Path:"
                   VerticalAlignment="Center" />
        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Text="{Binding PathSelection, Mode=TwoWay}" />
        <CheckBox Grid.Row="1"
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  IsChecked="{Binding PathSelectionIsPlanningProject, Mode=TwoWay}"
                  Content="Path is planning project" />
        <StackPanel Grid.Row="1"
                    Grid.Column="3"
                    Orientation="Horizontal"
                    Spacing="8">
          <Button Content="Apply"
                  Command="{Binding ApplyPathSelectionCommand}" />
          <Button Content="Refresh"
                  Command="{Binding RefreshCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <planning:PlanningExplorerView Margin="12,0,12,8"
                                   MinHeight="0"
                                   DataContext="{Binding PlanningExplorer}" />
  </DockPanel>
  <Border Grid.Row="1"
          Height="28"
          Padding="8,3"
          Background="#2D2D30"
          BorderBrush="#555555"
          BorderThickness="0,1,0,0">
    <TextBlock Text="{Binding StatusText}"
               VerticalAlignment="Center"
               TextTrimming="CharacterEllipsis" />
  </Border>
  </Grid>
</Window>
