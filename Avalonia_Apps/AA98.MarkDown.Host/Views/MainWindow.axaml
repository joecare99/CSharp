<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AA98.MarkDown.Host.ViewModels"
        xmlns:models="using:AA98.MarkDown.Host.Models"
        xmlns:markdown="using:AA98.MarkDown.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="800"
        x:Class="AA98.MarkDown.Host.Views.MainWindow"
        x:Name="HostWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AA98.MarkDown.Host"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        FontSize="12">
  <Window.Styles>
    <Style Selector="TabControl TabItem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Bottom"
            Height="28"
            Padding="8,3"
            Background="{DynamicResource ThemeControlMidBrush}">
      <TextBlock Text="{Binding StatusText}"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <Border DockPanel.Dock="Top"
            Margin="12,0,12,8"
            Padding="8"
            BorderBrush="{DynamicResource ThemeControlMidBrush}"
            BorderThickness="1"
            CornerRadius="4">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0"
                 Watermark="Markdown file path (*.md)"
                 Text="{Binding DocumentPathInput, Mode=TwoWay}" />
        <Button Grid.Column="1"
                Content="Open"
                Click="OnOpenRequested" />
        <ToggleButton Grid.Column="2"
                      Content="Preview"
                      IsChecked="{Binding IsPreviewEnabled, Mode=TwoWay}" />
      </Grid>
    </Border>

    <Menu DockPanel.Dock="Top"
          Margin="12,8">
      <MenuItem Header="_File">
        <MenuItem Header="New"
                  Command="{Binding NewDocumentCommand}" />
        <MenuItem Header="Open..."
                  Click="OnOpenRequested" />
        <MenuItem Header="Save"
                  Command="{Binding SaveCommand}" />
        <MenuItem Header="Save As..."
                  Click="OnSaveAsRequested" />
        <MenuItem Header="Close Tab"
                  Click="OnCloseTabRequested" />
      </MenuItem>
    </Menu>

    <TabControl Margin="12,0,12,8"
                MinHeight="0"
                ItemsSource="{Binding Documents}"
                SelectedItem="{Binding SelectedDocument, Mode=TwoWay}">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="models:MarkdownDocumentTab">
          <TextBlock Text="{Binding DisplayTitle}" />
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="models:MarkdownDocumentTab">
          <markdown:MarkdownEditorPreview HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          IsPreviewEnabled="{Binding DataContext.IsPreviewEnabled, ElementName=HostWindow}"
                                          Text="{Binding Text, Mode=TwoWay}"
                                          LinkInvoked="OnMarkdownLinkInvoked" />
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
  </DockPanel>
</Window>
