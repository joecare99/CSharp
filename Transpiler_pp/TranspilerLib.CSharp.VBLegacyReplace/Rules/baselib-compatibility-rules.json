      "id": "VB.BaseLib.Conversion.Val",
      "sourceTemplate": "Conversion.Val(<Param1>)",
      "replacementTemplate": "(<Param1>).AsDouble()",
      "requiredUsings": ["BaseLib.Helper"],
      "priority": 50,
      "enabled": true,
      "documentation": "Uses BaseLib ObjectHelper.AsDouble. It intentionally differs from Visual Basic Val for parsing, culture, invalid input, and null-like values."
    },
