<Project>
  <Import Project="..\Libraries.props" />
  <PropertyGroup>
	<TargetFrameworks>net462;net472;net48;net481;net8.0</TargetFrameworks>
	<NoDefaultExcludes>true</NoDefaultExcludes>
	<IsPackable>true</IsPackable>
	<IncludeBuildOutput>false</IncludeBuildOutput>
	<PackageId>JCSoft.CSharpBible.Libraries.Windows</PackageId>
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <PackageOutputPath>$(UpDir)\..\.packages</PackageOutputPath>
	<Version>1.0.0-b</Version>
	<Title>CSharpBible Libraries Windows</Title>
	<Description>Windows-specific package for the CSharpBible libraries.</Description>
	<PackageReadmeFile>README.Windows.md</PackageReadmeFile>
	  <Configurations>Debug;Release</Configurations>
  </PropertyGroup>
	<Import Sdk="Microsoft.NET.Sdk" Project="Sdk.props" />
	<Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" />
	<PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '9.0.100'))">
		<TargetFrameworks>$(TargetFrameworks);net9.0</TargetFrameworks>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0.100'))">
		<TargetFrameworks>$(TargetFrameworks);net10.0</TargetFrameworks>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0.100'))">
		<TargetFrameworks>$(TargetFrameworks);net11.0</TargetFrameworks>
	</PropertyGroup>
  <ItemGroup>
	<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	<PackageReference Include="JCSoft.CSharpBible.Libraries.Core" Version="1.0.0-b" />
	<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
	<None Include="README.Windows.md" Pack="true" PackagePath="\" />
	<None Include="$(UpDir)\..\bin\CommonDialogs\$(Configuration)\**\*.dll" Pack="true" PackagePath="lib" Visible="false" />
	<None Include="$(UpDir)\..\bin\CommonDialogs\$(Configuration)\**\*.xml" Pack="true" PackagePath="lib" Visible="false" />
	<None Include="$(UpDir)\..\bin\CommonDialogs_net\$(Configuration)\**\*.dll" Pack="true" PackagePath="lib" Visible="false" />
	<None Include="$(UpDir)\..\bin\CommonDialogs_net\$(Configuration)\**\*.xml" Pack="true" PackagePath="lib" Visible="false" />
	<None Include="$(UpDir)\..\bin\ConsoleLib.ExtCon\$(Configuration)\**\*.dll" Pack="true" PackagePath="lib" Visible="false" />
	<None Include="$(UpDir)\..\bin\ConsoleLib.ExtCon\$(Configuration)\**\*.xml" Pack="true" PackagePath="lib" Visible="false" />
	<None Include="$(UpDir)\..\bin\ExtendedConsole\$(Configuration)\**\*.dll" Pack="true" PackagePath="lib" Visible="false" />
	<None Include="$(UpDir)\..\bin\ExtendedConsole\$(Configuration)\**\*.xml" Pack="true" PackagePath="lib" Visible="false" />
	<None Include="$(UpDir)\..\bin\MVVM_BaseLib\$(Configuration)\**\*.dll" Pack="true" PackagePath="lib" Visible="false" />
	<None Include="$(UpDir)\..\bin\MVVM_BaseLib\$(Configuration)\**\*.xml" Pack="true" PackagePath="lib" Visible="false" />
	<None Include="$(UpDir)\..\bin\WFSystem.Windows.Data\$(Configuration)\**\*.dll" Pack="true" PackagePath="lib" Visible="false" />
	<None Include="$(UpDir)\..\bin\WFSystem.Windows.Data\$(Configuration)\**\*.xml" Pack="true" PackagePath="lib" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>
</Project>