<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:designer="using:ConsoleLib.Cxaml.Designer.Controls" x:Class="ConsoleLib.Cxaml.Designer.Views.EditorPreviewView"><Grid RowDefinitions="Auto,*,Auto"><Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8"><TextBlock Text="Selected element:" VerticalAlignment="Center" Margin="0,0,8,0" /><ComboBox Grid.Column="1" ItemsSource="{Binding PreviewMappings}" SelectedValue="{Binding SelectedPreviewControlId}" SelectedValueBinding="{Binding Id}" PlaceholderText="Select element" /></Grid><Grid Grid.Row="1" RowDefinitions="*,*"><Grid Grid.Row="0" RowDefinitions="*,Auto"><designer:SourceEditor Text="{Binding Markup, Mode=TwoWay}" CaretOffset="{Binding SourceCaretOffset, Mode=TwoWay}" /><TextBlock Grid.Row="1" Text="{Binding Diagnostics}" Foreground="DarkRed" /></Grid><TabControl Grid.Row="1" Margin="8" SelectedIndex="{Binding SelectedPreviewTabIndex}"><TabItem Header="Visual"><Border BorderBrush="Gray" BorderThickness="1" Padding="8"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><ContentControl Content="{Binding RenderedPreview}" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" /></ScrollViewer></Border></TabItem><TabItem Header="Console"><Border BorderBrush="Gray" BorderThickness="1" Padding="8"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ConsolePreviewText" Text="{Binding ConsolePreview}" FontFamily="Consolas" PointerPressed="ConsolePreviewText_OnPointerPressed" /></ScrollViewer></Border></TabItem></TabControl></Grid><TextBlock Grid.Row="2" Text="{Binding SelectedElement}" Margin="8,4,8,0" /></Grid></UserControl>