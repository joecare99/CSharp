<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:ConsoleLib.Cxaml.Designer.ViewModels"
			 x:Class="ConsoleLib.Cxaml.Designer.Views.InspectorView">
  <StackPanel Spacing="8">
	<TextBlock Text="Inspector" FontWeight="Bold" />
	<TextBlock Text="{Binding SelectedElement}" />
	<TextBlock Text="{Binding Preview}" FontFamily="Consolas" />
	<ItemsControl ItemsSource="{Binding CategorizedInspectorProperties}">
	  <ItemsControl.ItemTemplate>
		<DataTemplate>
		  <Grid ColumnDefinitions="110,*" Margin="0,2">
			<TextBlock Text="{Binding Category}" Foreground="Gray" />
			<TextBlock Grid.Column="1" Text="{Binding Name}" />
		  </Grid>
		</DataTemplate>
	  </ItemsControl.ItemTemplate>
	</ItemsControl>
	<ComboBox ItemsSource="{Binding InspectorProperties}" DisplayMemberBinding="{Binding Name}"
			  SelectedItem="{Binding SelectedPropertyName}" />
	<TextBox Text="{Binding SelectedPropertyValue}" />
	<Button Content="Apply property" Command="{Binding ApplySelectedPropertyCommand}" />
	<StackPanel IsVisible="{Binding IsGridSelected}" Spacing="4">
	  <TextBlock Text="Grid definitions" FontWeight="Bold" />
	  <TextBlock Text="Rows" Foreground="Gray" />
	  <ItemsControl ItemsSource="{Binding GridRows}">
		<ItemsControl.ItemTemplate>
		  <DataTemplate>
			<Grid ColumnDefinitions="*,70,70,Auto">
			  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
			  <ComboBox Grid.Column="1" ItemsSource="{Binding Source={x:Static vm:GridUnitTypeValues.All}}"
						SelectedItem="{Binding Unit}" />
			  <NumericUpDown Grid.Column="2" Value="{Binding Value}" Minimum="0" />
			  <Button Grid.Column="3" Content="-" Command="{Binding $parent[Window].DataContext.RemoveGridRowCommand}"
					  CommandParameter="{Binding}" />
			</Grid>
		  </DataTemplate>
		</ItemsControl.ItemTemplate>
	  </ItemsControl>
	  <Button Content="Add row" Command="{Binding AddGridRowCommand}" />
	  <TextBlock Text="Columns" Foreground="Gray" />
	  <ItemsControl ItemsSource="{Binding GridColumns}">
		<ItemsControl.ItemTemplate>
		  <DataTemplate>
			<Grid ColumnDefinitions="*,70,70,Auto">
			  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
			  <ComboBox Grid.Column="1" ItemsSource="{Binding Source={x:Static vm:GridUnitTypeValues.All}}"
						SelectedItem="{Binding Unit}" />
			  <NumericUpDown Grid.Column="2" Value="{Binding Value}" Minimum="0" />
			  <Button Grid.Column="3" Content="-" Command="{Binding $parent[Window].DataContext.RemoveGridColumnCommand}"
					  CommandParameter="{Binding}" />
			</Grid>
		  </DataTemplate>
		</ItemsControl.ItemTemplate>
	  </ItemsControl>
	  <Button Content="Add column" Command="{Binding AddGridColumnCommand}" />
	  <Button Content="Apply Grid definitions" Command="{Binding ApplyGridDefinitionsCommand}" />
	</StackPanel>
	<TextBlock Text="{Binding InspectorStatus}" />
  </StackPanel>
</UserControl>
