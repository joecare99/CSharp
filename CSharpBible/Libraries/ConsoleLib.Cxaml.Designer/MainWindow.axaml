<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ConsoleLib.Cxaml.Designer.Views"
        x:Class="ConsoleLib.Cxaml.Designer.MainWindow"
        Width="1000" Height="650" Title="ConsoleLib CXAML Designer">
  <Grid ColumnDefinitions="220,*,330" RowDefinitions="*,Auto">
    <StackPanel Grid.Column="0" Margin="8" Spacing="16">
      <views:ToolboxView />
      <views:ConfigurationView />
    </StackPanel>
    <views:EditorPreviewView Grid.Column="1" Margin="8" />
    <Border Grid.Column="2" Margin="8" BorderBrush="Gray" BorderThickness="1" Padding="8">
      <views:InspectorView />
    </Border>
  </Grid>
</Window>
