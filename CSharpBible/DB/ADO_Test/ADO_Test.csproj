<Project>
	<Import Project="..\DB_net.props" />

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>disable</ImplicitUsings>
		<Platforms>AnyCPU;x86</Platforms>
	</PropertyGroup>
	<Import Sdk="Microsoft.NET.Sdk" Project="Sdk.props" />
	<Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" />
	<ItemGroup>
	  <Compile Remove="obj\**" />
	  <EmbeddedResource Remove="obj\**" />
	  <None Remove="obj\**" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="Database1.mdf" />
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Include="Database1.mdf" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="System.Data.OleDb" Version="10.0.11" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Resource\DataSet1.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>DataSet1.xsd</DependentUpon>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
	  <None Update="Resource\DataSet1.xsd">
	    <Generator>MSDataSetGenerator</Generator>
	    <LastGenOutput>DataSet1.Designer.cs</LastGenOutput>
	  </None>
	  <None Update="Resource\Gen_Plusdaten.mdb">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>