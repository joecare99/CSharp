<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ollama.CodingAgent.Desktop.Widgets.CodeWikiPanel">
  <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" Padding="10">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
      <TextBlock FontSize="16" FontWeight="Bold" Text="CodeWikiVault" />
      <TextBox Grid.Row="1" Text="{Binding CodeWikiVaultPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Path to a Markdown vault" />
      <Button Grid.Row="2" HorizontalAlignment="Left" Command="{Binding ImportCodeWikiVaultCommand}" Content="Import Markdown vault" />
      <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
        <TextBox Text="{Binding WikiQuery, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search imported wiki pages" />
        <Button Grid.Column="1" Command="{Binding SearchWikiCommand}" Content="Search" />
      </Grid>
      <StackPanel Grid.Row="4" Spacing="6">
        <TextBlock Opacity="0.7" Text="{Binding WikiStatus}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding WikiSearchResults}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1" Padding="6" Margin="0,0,0,4">
                <StackPanel Spacing="3">
                  <TextBlock FontWeight="Bold" Text="{Binding Title}" />
                  <TextBlock MaxHeight="80" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                  <TextBlock FontSize="11" Opacity="0.7" Text="{Binding Id}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
