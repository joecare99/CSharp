<Window x:Class="ScriptedSvgWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScriptedSvgWpf"
        Title="Scripted SVG" Width="1200" Height="760"
        MinWidth="850" MinHeight="520">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Command="{Binding NewDocumentCommand}" Content="New" />
            <Button Command="{Binding OpenDocumentCommand}" Content="Open" Margin="4,0,0,0" />
            <Button Command="{Binding SaveDocumentCommand}" Content="Save" Margin="4,0,0,0" />
            <Separator />
            <Button Command="{Binding RunCommand}" Content="Preview" />
            <Button Command="{Binding ExportSvgCommand}" Content="Export SVG" Margin="4,0,0,0" />
            <TextBlock Text="{Binding DocumentName}" Margin="16,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text=" *" Foreground="DarkOrange" Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </ToolBar>
             <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding StatusText}" />
        </StatusBar>
   <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="260" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" Text="{Binding ScriptText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas"
                         FontSize="13" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                <Border Grid.Row="1" Margin="0,8,0,0" Padding="6" Background="#FFF4F4F4"
                        BorderBrush="#FFD0D0D0" BorderThickness="1">
                    <TextBlock Text="{Binding ErrorText}" Foreground="Firebrick" TextWrapping="Wrap" />
                </Border>
            </Grid>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Border Grid.Column="2" Background="#FFECECEC" BorderBrush="#FFD0D0D0" BorderThickness="1">
                <local:PreviewSurface Document="{Binding PreviewDocument}" Margin="8"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      MinWidth="1" MinHeight="1" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
